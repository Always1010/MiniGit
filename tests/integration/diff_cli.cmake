set(repo "${CMAKE_CURRENT_BINARY_DIR}/diff-cli-repository")
file(REMOVE_RECURSE "${repo}")
file(MAKE_DIRECTORY "${repo}")
function(run_ok)
    execute_process(COMMAND "${MINIGIT}" ${ARGV} WORKING_DIRECTORY "${repo}"
        RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_VARIABLE err)
    if(NOT rc EQUAL 0)
        message(FATAL_ERROR "${ARGV}: ${rc} ${err}")
    endif()
    set(output "${out}" PARENT_SCOPE)
endfunction()
function(require_change old new)
    string(FIND "${output}" "-${old}\n" removed)
    string(FIND "${output}" "+${new}\n" added)
    if(removed EQUAL -1 OR added EQUAL -1)
        message(FATAL_ERROR "wrong diff direction: ${output}")
    endif()
endfunction()
run_ok(init)
run_ok(diff)
if(NOT output STREQUAL "")
    message(FATAL_ERROR "empty index should have no worktree diff")
endif()
file(WRITE "${repo}/note" "A\n")
run_ok(add note)
run_ok(diff --cached -U0)
if(NOT output MATCHES "new file mode 100644" OR NOT output MATCHES "@@ -0,0 [+]1,1 @@\n[+]A\n")
    message(FATAL_ERROR "unborn staged addition failed: ${output}")
endif()
run_ok(config user.name Learner)
run_ok(config user.email learner@example.test)
run_ok(commit -m first)
file(READ "${repo}/.minigit/refs/heads/main" first)
string(STRIP "${first}" first)
file(WRITE "${repo}/note" "B\n")
run_ok(add note)
file(SHA256 "${repo}/.minigit/index" original_index)
file(WRITE "${repo}/note" "C\n")
file(WRITE "${repo}/untracked" "do not display\n")
run_ok(hash-object note)
string(STRIP "${output}" working_id)
string(SUBSTRING "${working_id}" 0 2 fanout)
string(SUBSTRING "${working_id}" 2 62 rest)
run_ok(diff -U 0)
require_change(B C)
if(output MATCHES "untracked")
    message(FATAL_ERROR "diff displayed untracked file")
endif()
run_ok(diff --cached)
require_change(A B)
set(cached "${output}")
run_ok(diff --staged)
if(NOT output STREQUAL cached)
    message(FATAL_ERROR "--staged alias differs")
endif()
run_ok(diff --unified=0 HEAD)
require_change(A C)
run_ok(diff --cached "${first}")
require_change(A B)
file(SHA256 "${repo}/.minigit/index" after_index)
file(READ "${repo}/.minigit/refs/heads/main" after_head)
string(STRIP "${after_head}" after_head)
if(NOT original_index STREQUAL after_index OR NOT after_head STREQUAL first OR
   EXISTS "${repo}/.minigit/objects/${fanout}/${rest}")
    message(FATAL_ERROR "diff changed index HEAD or saved working blob")
endif()
run_ok(add note)
run_ok(commit -m second)
file(READ "${repo}/.minigit/refs/heads/main" second)
string(STRIP "${second}" second)
run_ok(diff)
if(NOT output STREQUAL "")
    message(FATAL_ERROR "clean tracked file should have no diff")
endif()
run_ok(diff "${first}" "${second}")
require_change(A C)
run_ok(diff "${second}" "${first}" --unified 0)
require_change(C A)
file(CHMOD "${repo}/note" PERMISSIONS OWNER_READ OWNER_WRITE OWNER_EXECUTE GROUP_READ WORLD_READ)
run_ok(diff)
if(NOT output MATCHES "old mode 100644\nnew mode 100755" OR output MATCHES "@@")
    message(FATAL_ERROR "mode-only worktree diff failed: ${output}")
endif()
file(REMOVE "${repo}/note")
run_ok(diff)
if(NOT output MATCHES "deleted file mode 100644" OR NOT output MATCHES "[+][+][+] /dev/null")
    message(FATAL_ERROR "worktree deletion failed")
endif()
run_ok(add note)
file(WRITE "${repo}/empty" "")
run_ok(add empty)
run_ok(diff)
if(NOT output STREQUAL "")
    message(FATAL_ERROR "staged deletion and empty addition should not be unstaged changes")
endif()
run_ok(diff --cached)
if(NOT output MATCHES "deleted file mode 100644" OR NOT output MATCHES "[+][+][+] b/empty")
    message(FATAL_ERROR "staged deletion or empty addition omitted")
endif()
foreach(args IN ITEMS "--unknown" "-U;-1" "-U" "-U;100001" "-U;invalid" "-U0;-U1" "--unified=" "--cached;HEAD;HEAD" "HEAD;HEAD;HEAD")
    execute_process(COMMAND "${MINIGIT}" diff ${args} WORKING_DIRECTORY "${repo}" RESULT_VARIABLE rc)
    if(NOT rc EQUAL 2)
        message(FATAL_ERROR "diff accepted invalid options: ${args}")
    endif()
endforeach()
execute_process(COMMAND "${MINIGIT}" diff missing WORKING_DIRECTORY "${repo}"
    RESULT_VARIABLE rc OUTPUT_VARIABLE out)
if(NOT rc EQUAL 1 OR NOT out STREQUAL "")
    message(FATAL_ERROR "unknown revision should fail without partial output")
endif()
file(WRITE "${repo}/.minigit/index" "damaged")
execute_process(COMMAND "${MINIGIT}" diff WORKING_DIRECTORY "${repo}"
    RESULT_VARIABLE rc OUTPUT_VARIABLE out)
if(NOT rc EQUAL 1 OR NOT out STREQUAL "")
    message(FATAL_ERROR "damaged index should fail without partial output")
endif()
run_ok(diff "${first}" "${second}")
require_change(A C)
file(REMOVE_RECURSE "${repo}")
