set(repo "${CMAKE_CURRENT_BINARY_DIR}/show-cli-repository")
file(REMOVE_RECURSE "${repo}")
file(MAKE_DIRECTORY "${repo}")
function(run_ok)
    execute_process(COMMAND "${MINIGIT}" ${ARGV} WORKING_DIRECTORY "${repo}"
        RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_VARIABLE err)
    if(NOT rc EQUAL 0)
        message(FATAL_ERROR "${ARGV}: ${rc} ${err}")
    endif()
    set(output "${out}" PARENT_SCOPE)
endfunction()
function(expect_error code)
    execute_process(COMMAND "${MINIGIT}" show ${ARGN} WORKING_DIRECTORY "${repo}"
        RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_VARIABLE err)
    if(NOT rc EQUAL code OR NOT out STREQUAL "")
        message(FATAL_ERROR "show ${ARGN} should fail with ${code} and no partial output: ${rc} ${out} ${err}")
    endif()
endfunction()
run_ok(init)
expect_error(1)
run_ok(config user.name Learner)
run_ok(config user.email learner@example.test)
file(WRITE "${repo}/note" "A\n")
file(MAKE_DIRECTORY "${repo}/dir")
file(WRITE "${repo}/dir/space name" "nested\n")
run_ok(hash-object note)
string(STRIP "${output}" first_blob)
run_ok(add -A)
run_ok(commit -m "first\n\nexplanation")
file(READ "${repo}/.minigit/refs/heads/main" first)
string(STRIP "${first}" first)
run_ok(cat-file -p "${first}")
string(REGEX MATCH "^tree ([0-9a-f]+)\n" found "${output}")
set(first_tree "${CMAKE_MATCH_1}")
run_ok(tag saved-A)
run_ok(tag -- -label)
run_ok(show)
if(NOT output MATCHES "^commit ${first}\n" OR NOT output MATCHES "    explanation\n" OR
   NOT output MATCHES "new file mode 100644" OR NOT output MATCHES "[+]A\n")
    message(FATAL_ERROR "show root commit omitted metadata or creation patch: ${output}")
endif()
set(root_output "${output}")
run_ok(show saved-A)
if(NOT output STREQUAL root_output)
    message(FATAL_ERROR "show tag did not select commit")
endif()
run_ok(show -- -label)
if(NOT output STREQUAL root_output)
    message(FATAL_ERROR "show -- did not allow option-like ref")
endif()
run_ok(show "${first_blob}")
if(NOT output STREQUAL "A\n")
    message(FATAL_ERROR "show raw blob failed")
endif()
run_ok(show "${first_tree}")
if(NOT output MATCHES "100644 ${first_blob} note\n" OR NOT output MATCHES "40000 [0-9a-f]+ dir\n")
    message(FATAL_ERROR "show raw tree failed: ${output}")
endif()
file(WRITE "${repo}/note" "B\n")
run_ok(add note)
file(SHA256 "${repo}/.minigit/index" original_index)
file(WRITE "${repo}/note" "C\n")
run_ok(show HEAD:note)
if(NOT output STREQUAL "A\n")
    message(FATAL_ERROR "show HEAD:path used working content")
endif()
run_ok(show :note)
if(NOT output STREQUAL "B\n")
    message(FATAL_ERROR "show :path did not use staged content")
endif()
run_ok(show :0:note)
if(NOT output STREQUAL "B\n")
    message(FATAL_ERROR "explicit stage zero failed")
endif()
run_ok(show "saved-A:dir/space name")
if(NOT output STREQUAL "nested\n")
    message(FATAL_ERROR "show nested spaced path failed")
endif()
file(SHA256 "${repo}/.minigit/index" after_index)
file(READ "${repo}/.minigit/refs/heads/main" after_head)
string(STRIP "${after_head}" after_head)
if(NOT original_index STREQUAL after_index OR NOT after_head STREQUAL first)
    message(FATAL_ERROR "show changed index or HEAD")
endif()
run_ok(commit -m second)
file(READ "${repo}/.minigit/refs/heads/main" second)
string(STRIP "${second}" second)
run_ok(show)
if(NOT output MATCHES "^commit ${second}\nparent ${first}\n" OR NOT output MATCHES "-A\n[+]B\n" OR
   output MATCHES "[+]C\n")
    message(FATAL_ERROR "show did not compare committed B with parent A: ${output}")
endif()
foreach(spec IN ITEMS missing HEAD:missing HEAD:dir HEAD:../note :1:note :.minigit/HEAD)
    expect_error(1 "${spec}")
endforeach()
expect_error(2 --unknown)
expect_error(2 HEAD extra)
file(WRITE "${repo}/.minigit/index" "damaged")
expect_error(1 :note)
run_ok(show HEAD:note)
if(NOT output STREQUAL "B\n")
    message(FATAL_ERROR "historical show incorrectly depends on index")
endif()
run_ok(show "${first_blob}")
if(NOT output STREQUAL "A\n")
    message(FATAL_ERROR "raw show incorrectly depends on index")
endif()
string(SUBSTRING "${first_blob}" 0 2 fanout)
string(SUBSTRING "${first_blob}" 2 62 rest)
file(REMOVE "${repo}/.minigit/objects/${fanout}/${rest}")
expect_error(1 "${first}")
file(REMOVE_RECURSE "${repo}")
