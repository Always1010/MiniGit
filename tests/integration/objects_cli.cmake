set(repo "${CMAKE_CURRENT_BINARY_DIR}/objects-cli-repository")
file(REMOVE_RECURSE "${repo}")
file(MAKE_DIRECTORY "${repo}")
function(run_ok)
    execute_process(COMMAND "${MINIGIT}" ${ARGV} WORKING_DIRECTORY "${repo}"
        RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_VARIABLE err)
    if(NOT rc EQUAL 0)
        message(FATAL_ERROR "${ARGV}: ${rc} ${err}")
    endif()
    set(output "${out}" PARENT_SCOPE)
endfunction()
run_ok(init .)
file(READ "${repo}/.minigit/HEAD" head)
if(NOT head STREQUAL "ref: refs/heads/main\n")
    message(FATAL_ERROR "wrong initial HEAD")
endif()
file(WRITE "${repo}/note.txt" "stored\n")
run_ok(hash-object note.txt)
string(STRIP "${output}" expected)
string(LENGTH "${expected}" size)
if(NOT size EQUAL 64 OR NOT expected MATCHES "^[0-9a-f]+$")
    message(FATAL_ERROR "invalid hash output")
endif()
file(GLOB_RECURSE objects LIST_DIRECTORIES FALSE "${repo}/.minigit/objects/*")
if(objects)
    message(FATAL_ERROR "hash-object without -w wrote an object")
endif()
run_ok(hash-object -w note.txt)
string(STRIP "${output}" actual)
if(NOT actual STREQUAL expected)
    message(FATAL_ERROR "hash changed while storing")
endif()
run_ok(cat-file -t "${actual}")
if(NOT output STREQUAL "blob\n")
    message(FATAL_ERROR "wrong object type")
endif()
file(WRITE "${repo}/note.txt" "edited\n")
run_ok(cat-file -p "${actual}")
if(NOT output STREQUAL "stored\n")
    message(FATAL_ERROR "object was changed by worktree edit")
endif()
file(MAKE_DIRECTORY "${repo}/nested")
execute_process(COMMAND "${MINIGIT}" init "${repo}" RESULT_VARIABLE rc)
execute_process(COMMAND "${MINIGIT}" cat-file -p "${actual}" WORKING_DIRECTORY "${repo}/nested"
    RESULT_VARIABLE nested_rc OUTPUT_VARIABLE output)
if(NOT rc EQUAL 0 OR NOT nested_rc EQUAL 0 OR NOT output STREQUAL "stored\n")
    message(FATAL_ERROR "reinitialization or nested discovery lost objects")
endif()
execute_process(COMMAND "${MINIGIT}" cat-file -p invalid WORKING_DIRECTORY "${repo}"
    RESULT_VARIABLE rc ERROR_VARIABLE err)
if(NOT rc EQUAL 1 OR err STREQUAL "")
    message(FATAL_ERROR "invalid object ID accepted")
endif()
file(REMOVE_RECURSE "${repo}")
