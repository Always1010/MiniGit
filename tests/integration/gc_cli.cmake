set(repo "${CMAKE_CURRENT_BINARY_DIR}/gc-cli-repository")
file(REMOVE_RECURSE "${repo}")
file(MAKE_DIRECTORY "${repo}")
function(run_ok)
    execute_process(COMMAND "${MINIGIT}" ${ARGV} WORKING_DIRECTORY "${repo}"
        RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_VARIABLE err)
    if(NOT rc EQUAL 0 OR NOT err STREQUAL "")
        message(FATAL_ERROR "${ARGV}: ${rc} ${out} ${err}")
    endif()
    set(output "${out}" PARENT_SCOPE)
endfunction()
function(run_error expected)
    execute_process(COMMAND "${MINIGIT}" ${ARGN} WORKING_DIRECTORY "${repo}"
        RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_VARIABLE err)
    if(NOT rc EQUAL expected OR NOT out STREQUAL "" OR err STREQUAL "")
        message(FATAL_ERROR "${ARGN}: expected ${expected}, got ${rc}: ${out} ${err}")
    endif()
endfunction()
function(stored_id path)
    run_ok(hash-object -w "${path}")
    string(STRIP "${output}" id)
    string(LENGTH "${id}" length)
    if(NOT length EQUAL 64 OR NOT id MATCHES "^[0-9a-f]+$")
        message(FATAL_ERROR "expected full object ID")
    endif()
    set(id "${id}" PARENT_SCOPE)
endfunction()
function(object_path id)
    string(SUBSTRING "${id}" 0 2 fanout)
    string(SUBSTRING "${id}" 2 62 suffix)
    set(path "${repo}/.minigit/objects/${fanout}/${suffix}" PARENT_SCOPE)
endfunction()
function(head_id)
    run_ok(log -n 1)
    string(REGEX MATCH "^commit ([0-9a-f]+)\n" line "${output}")
    set(id "${CMAKE_MATCH_1}" PARENT_SCOPE)
endfunction()

run_ok(init)
run_ok(gc)
if(NOT output STREQUAL "GC retained 0 objects; removed 0 objects.\n")
    message(FATAL_ERROR "empty GC: ${output}")
endif()
foreach(flag IN ITEMS --unknown --prune-now=1 --dry-run --)
    run_error(2 gc "${flag}")
endforeach()
run_error(2 gc --prune-now --prune-now)

# Unborn HEAD still keeps the current Index; ordinary Work is not a GC root.
file(WRITE "${repo}/staged" "index-only\n")
run_ok(add staged)
stored_id(staged)
set(index_blob "${id}")
file(WRITE "${repo}/orphan" "genuinely unreachable\n")
stored_id(orphan)
set(orphan "${id}")
run_ok(gc)
run_ok(cat-file -p "${orphan}")
if(NOT output STREQUAL "genuinely unreachable\n")
    message(FATAL_ERROR "fresh orphan was removed")
endif()
file(SHA256 "${repo}/.minigit/index" before_index)
run_ok(gc --prune-now)
if(NOT output STREQUAL "GC retained 1 objects; removed 1 objects.\n")
    message(FATAL_ERROR "wrong Index/orphan closure: ${output}")
endif()
run_error(1 cat-file -t "${orphan}")
run_ok(cat-file -p "${index_blob}")
file(SHA256 "${repo}/.minigit/index" after_index)
if(NOT before_index STREQUAL after_index)
    message(FATAL_ERROR "GC rewrote Index")
endif()
file(READ "${repo}/orphan" work)
if(NOT work STREQUAL "genuinely unreachable\n")
    message(FATAL_ERROR "GC changed Work")
endif()

# Reflogs keep rewritten history; both stash entries remain restorable.
run_ok(config user.name GC)
run_ok(config user.email gc@example.test)
run_ok(commit -m base)
head_id()
set(base "${id}")
file(WRITE "${repo}/staged" "later\n")
run_ok(add staged)
run_ok(commit -m later)
head_id()
set(later "${id}")
run_ok(reset --hard "${base}")
file(WRITE "${repo}/staged" "older saved\n")
run_ok(stash push -m older)
file(WRITE "${repo}/staged" "newer saved\n")
run_ok(stash push -m newer)
run_ok(gc --prune-now)
run_ok(cat-file -t "${later}")
run_ok(stash show "stash@{1}")
if(NOT output MATCHES "older saved")
    message(FATAL_ERROR "non-top stash was lost: ${output}")
endif()
run_ok(stash pop)
run_ok(restore staged)
run_ok(stash pop)
file(READ "${repo}/staged" restored)
if(NOT restored STREQUAL "older saved\n")
    message(FATAL_ERROR "older stash did not restore")
endif()

# Every object, including orphans, is validated before the first deletion.
file(WRITE "${repo}/good-orphan" "valid candidate\n")
stored_id(good-orphan)
set(good "${id}")
object_path("${good}")
set(good_path "${path}")
file(WRITE "${repo}/bad-orphan" "corrupt candidate\n")
stored_id(bad-orphan)
set(bad "${id}")
object_path("${bad}")
file(WRITE "${path}" "broken compressed object")
file(GLOB_RECURSE before LIST_DIRECTORIES FALSE "${repo}/.minigit/objects/*")
run_error(1 gc --prune-now)
file(GLOB_RECURSE after LIST_DIRECTORIES FALSE "${repo}/.minigit/objects/*")
if(NOT before STREQUAL after OR NOT EXISTS "${good_path}")
    message(FATAL_ERROR "preflight failure deleted objects")
endif()
file(REMOVE "${path}")
file(WRITE "${repo}/.minigit/objects/unexpected" "unknown inventory")
run_error(1 gc --prune-now)
if(NOT EXISTS "${good_path}")
    message(FATAL_ERROR "unsafe inventory partially deleted")
endif()
file(REMOVE "${repo}/.minigit/objects/unexpected")
run_ok(gc --prune-now)
run_error(1 cat-file -t "${good}")
run_ok(gc --prune-now)
if(NOT output MATCHES "removed 0 objects")
    message(FATAL_ERROR "repeated GC is not idempotent: ${output}")
endif()
