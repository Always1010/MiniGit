set(repo "${CMAKE_CURRENT_BINARY_DIR}/remove-cli-repository")
file(REMOVE_RECURSE "${repo}")
file(MAKE_DIRECTORY "${repo}")
function(run_ok)
    execute_process(COMMAND "${MINIGIT}" ${ARGV} WORKING_DIRECTORY "${repo}"
        RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_VARIABLE err)
    if(NOT rc EQUAL 0 OR (ARGV0 STREQUAL "rm" AND NOT out STREQUAL ""))
        message(FATAL_ERROR "${ARGV}: ${rc} ${out} ${err}")
    endif()
    set(output "${out}" PARENT_SCOPE)
endfunction()
function(run_error expected)
    execute_process(COMMAND "${MINIGIT}" ${ARGN} WORKING_DIRECTORY "${repo}"
        RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_VARIABLE err)
    if(NOT rc EQUAL expected OR NOT out STREQUAL "")
        message(FATAL_ERROR "${ARGN}: expected ${expected}, got ${rc}, ${out} ${err}")
    endif()
endfunction()
function(expect_file path expected)
    file(READ "${repo}/${path}" observed)
    if(NOT observed STREQUAL expected)
        message(FATAL_ERROR "${path}: expected '${expected}', got '${observed}'")
    endif()
endfunction()
function(expect_index path expected)
    run_ok(show ":${path}")
    if(NOT output STREQUAL expected)
        message(FATAL_ERROR "index ${path}: expected '${expected}', got '${output}'")
    endif()
endfunction()
run_ok(init)
run_error(2 rm)
run_error(2 rm --dry-run note)
run_error(2 rm -r --recursive note)
run_error(2 rm -f --force note)
run_error(2 rm --cached --cached note)
file(WRITE "${repo}/new" "staged unborn\n")
run_ok(add new)
run_error(1 rm new)
run_ok(rm --cached new)
expect_file(new "staged unborn\n")
run_error(1 show :new)
run_ok(add new)
file(WRITE "${repo}/new" "dirty unborn\n")
run_error(1 rm --cached new)
run_ok(rm --force --cached new)
expect_file(new "dirty unborn\n")
run_ok(add new)
run_ok(rm -f new)
if(EXISTS "${repo}/new" OR EXISTS "${repo}/.minigit/refs/heads/main" OR EXISTS "${repo}/.minigit/logs/HEAD")
    message(FATAL_ERROR "unborn rm failed or created reference metadata")
endif()
run_ok(config user.name Learner)
run_ok(config user.email learner@example.test)
file(WRITE "${repo}/note" "A\n")
file(WRITE "${repo}/clean" "clean\n")
file(WRITE "${repo}/missing" "missing\n")
file(WRITE "${repo}/-name" "option file\n")
file(WRITE "${repo}/shape" "shape file\n")
file(MAKE_DIRECTORY "${repo}/dir")
file(WRITE "${repo}/dir/file" "nested\n")
run_ok(add -A)
run_ok(commit -m A)
foreach(path IN ITEMS HEAD refs/heads/main logs/HEAD logs/refs/heads/main identity)
    file(SHA256 "${repo}/.minigit/${path}" before_${path})
endforeach()
# Multi-path validation must complete before publishing any deletion.
file(WRITE "${repo}/note" "dirty\n")
file(SHA256 "${repo}/.minigit/index" before_index)
run_error(1 rm clean note)
expect_file(clean "clean\n")
expect_file(note "dirty\n")
expect_index(clean "clean\n")
file(SHA256 "${repo}/.minigit/index" observed_index)
if(NOT before_index STREQUAL observed_index)
    message(FATAL_ERROR "refused rm changed the index")
endif()
run_error(1 rm clean nonexistent)
expect_file(clean "clean\n")
# Cached deletion preserves C when B==A; B!=A requires B==C.
run_ok(rm --cached note)
expect_file(note "dirty\n")
run_error(1 show :note)
run_ok(restore -S note)
file(WRITE "${repo}/note" "B\n")
run_ok(add note)
file(WRITE "${repo}/note" "C\n")
run_error(1 rm --cached note)
expect_index(note "B\n")
expect_file(note "C\n")
run_ok(restore note)
run_ok(rm --cached note)
expect_file(note "B\n")
run_ok(restore -S -W note)
file(REMOVE "${repo}/missing")
run_ok(rm missing)
run_error(1 show :missing)
run_ok(rm clean)
if(EXISTS "${repo}/clean")
    message(FATAL_ERROR "rm did not remove clean tracked file")
endif()
# -r selects tracked leaves; ignored and unknown siblings stay untouched.
file(WRITE "${repo}/.minigitignore" "dir/private\n")
file(WRITE "${repo}/dir/private" "private\n")
file(MAKE_DIRECTORY "${repo}/dir/empty-private")
run_error(1 rm dir)
run_ok(rm --recursive dir dir/file)
expect_file(dir/private "private\n")
if(EXISTS "${repo}/dir/file" OR NOT IS_DIRECTORY "${repo}/dir/empty-private")
    message(FATAL_ERROR "recursive rm deleted an unknown node or kept a tracked file")
endif()
run_ok(rm -- -name)
if(EXISTS "${repo}/-name")
    message(FATAL_ERROR "rm failed to interpret --")
endif()
# -f may discard tracked content, but grants no ownership of unknown children.
file(REMOVE "${repo}/shape")
file(MAKE_DIRECTORY "${repo}/shape")
file(WRITE "${repo}/shape/private" "unknown child\n")
run_error(1 rm shape)
run_error(1 rm -f shape)
expect_index(shape "shape file\n")
expect_file(shape/private "unknown child\n")
file(REMOVE "${repo}/shape/private")
run_ok(rm -f shape)
if(EXISTS "${repo}/shape")
    message(FATAL_ERROR "forced rm did not remove the selected empty replacement directory")
endif()
# Index-only deletion never follows a physical symlink when B==A.
set(outside "${CMAKE_CURRENT_BINARY_DIR}/remove-outside")
file(WRITE "${outside}" "outside\n")
file(REMOVE "${repo}/note")
file(CREATE_LINK "${outside}" "${repo}/note" SYMBOLIC RESULT link_result)
if(NOT link_result STREQUAL "0")
    message(FATAL_ERROR "cannot create fixture symlink: ${link_result}")
endif()
run_ok(rm --cached note)
if(NOT IS_SYMLINK "${repo}/note")
    message(FATAL_ERROR "cached rm changed the working symlink")
endif()
file(READ "${outside}" outside_bytes)
if(NOT outside_bytes STREQUAL "outside\n")
    message(FATAL_ERROR "cached rm followed the working symlink")
endif()
foreach(path IN ITEMS HEAD refs/heads/main logs/HEAD logs/refs/heads/main identity)
    file(SHA256 "${repo}/.minigit/${path}" observed)
    if(NOT observed STREQUAL "${before_${path}}")
        message(FATAL_ERROR "rm changed unrelated metadata ${path}")
    endif()
endforeach()
if(EXISTS "${repo}/.minigit/transaction")
    message(FATAL_ERROR "rm left a transaction journal")
endif()
file(REMOVE_RECURSE "${repo}")
file(REMOVE "${outside}")
