set(repo "${CMAKE_CURRENT_BINARY_DIR}/reflog-cli-repository")
file(REMOVE_RECURSE "${repo}")
file(MAKE_DIRECTORY "${repo}")
function(run_ok)
    execute_process(COMMAND "${MINIGIT}" ${ARGV} WORKING_DIRECTORY "${repo}"
        RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_VARIABLE err)
    if(NOT rc EQUAL 0)
        message(FATAL_ERROR "${ARGV}: ${rc} ${err}")
    endif()
    set(output "${out}" PARENT_SCOPE)
endfunction()
function(run_error expected)
    execute_process(COMMAND "${MINIGIT}" ${ARGN} WORKING_DIRECTORY "${repo}"
        RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_VARIABLE err)
    if(NOT rc EQUAL expected OR NOT out STREQUAL "")
        message(FATAL_ERROR "${ARGN}: expected ${expected}, got ${rc}, ${out} ${err}")
    endif()
endfunction()
run_ok(init)
run_ok(reflog)
if(NOT output STREQUAL "")
    message(FATAL_ERROR "unborn HEAD has no events")
endif()
run_ok(config user.name Learner)
run_ok(config user.email learner@example.test)
file(WRITE "${repo}/note" "A\n")
run_ok(add note)
run_ok(commit -m first)
file(READ "${repo}/.minigit/refs/heads/main" first)
string(STRIP "${first}" first)
file(WRITE "${repo}/note" "B\n")
run_ok(add note)
run_ok(commit -m second)
file(READ "${repo}/.minigit/refs/heads/main" second)
string(STRIP "${second}" second)
run_ok(reflog)
set(expected "HEAD@{0} ${first} -> ${second} commit\nHEAD@{1} - -> ${first} commit\n")
if(NOT output STREQUAL expected)
    message(FATAL_ERROR "HEAD events do not preserve chronological movement: ${output}")
endif()
file(SHA256 "${repo}/.minigit/logs/HEAD" head_log)
file(SHA256 "${repo}/.minigit/logs/refs/heads/main" branch_log)
if(NOT head_log STREQUAL branch_log)
    message(FATAL_ERROR "symbolic commit logs diverged")
endif()
run_ok(reflog main)
string(REPLACE "HEAD@" "refs/heads/main@" expected_branch "${expected}")
if(NOT output STREQUAL expected_branch)
    message(FATAL_ERROR "short branch selection failed")
endif()
run_ok(reflog refs/heads/main)
if(NOT output STREQUAL expected_branch)
    message(FATAL_ERROR "full branch selection failed")
endif()
file(SHA256 "${repo}/.minigit/index" index_hash)
run_error(1 commit -m unchanged)
run_error(2 reflog --unknown)
run_error(2 reflog HEAD extra)
run_error(1 reflog refs/tags/name)
run_ok(reflog -- -missing)
if(NOT output STREQUAL "")
    message(FATAL_ERROR "absent log is empty")
endif()
file(SHA256 "${repo}/.minigit/logs/HEAD" observed_head_log)
file(SHA256 "${repo}/.minigit/index" observed_index_hash)
if(NOT observed_head_log STREQUAL head_log OR NOT observed_index_hash STREQUAL index_hash)
    message(FATAL_ERROR "queries or rejected commits modified mutable metadata")
endif()
# Explicit low-level fixture: detached at the current ID preserves log continuity.
file(WRITE "${repo}/.minigit/HEAD" "${second}\n")
file(WRITE "${repo}/note" "C\n")
run_ok(add note)
run_ok(commit -m detached)
file(READ "${repo}/.minigit/HEAD" third)
string(STRIP "${third}" third)
run_ok(reflog)
if(NOT output MATCHES "^HEAD@[{]0[}] ${second} -> ${third} commit\n")
    message(FATAL_ERROR "detached commit event missing: ${output}")
endif()
file(SHA256 "${repo}/.minigit/logs/refs/heads/main" observed_branch_log)
file(READ "${repo}/.minigit/refs/heads/main" observed_branch)
string(STRIP "${observed_branch}" observed_branch)
if(NOT observed_branch_log STREQUAL branch_log OR NOT observed_branch STREQUAL second)
    message(FATAL_ERROR "detached commit moved branch or its log")
endif()
file(SHA256 "${repo}/.minigit/index" index_hash)
file(WRITE "${repo}/.minigit/logs/HEAD" "damaged")
run_error(1 reflog)
file(WRITE "${repo}/note" "D\n")
run_ok(add note)
file(SHA256 "${repo}/.minigit/index" staged_index_hash)
run_error(1 commit -m rejected)
file(READ "${repo}/.minigit/HEAD" observed_head)
file(READ "${repo}/.minigit/logs/HEAD" damaged)
file(SHA256 "${repo}/.minigit/index" observed_index_hash)
if(NOT observed_head STREQUAL "${third}\n" OR NOT damaged STREQUAL "damaged" OR NOT observed_index_hash STREQUAL staged_index_hash OR EXISTS "${repo}/.minigit/transaction")
    message(FATAL_ERROR "bad reflog commit changed HEAD, index or journal")
endif()
file(REMOVE_RECURSE "${repo}")
