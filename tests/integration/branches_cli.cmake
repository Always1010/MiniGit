set(repo "${CMAKE_CURRENT_BINARY_DIR}/branches-cli-repository")
file(REMOVE_RECURSE "${repo}")
file(MAKE_DIRECTORY "${repo}")
function(run_ok)
    execute_process(COMMAND "${MINIGIT}" ${ARGV} WORKING_DIRECTORY "${repo}"
        RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_VARIABLE err)
    if(NOT rc EQUAL 0)
        message(FATAL_ERROR "${ARGV}: ${rc} ${err}")
    endif()
    set(output "${out}" PARENT_SCOPE)
endfunction()
function(run_error expected)
    execute_process(COMMAND "${MINIGIT}" ${ARGN} WORKING_DIRECTORY "${repo}"
        RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_VARIABLE err)
    if(NOT rc EQUAL expected OR NOT out STREQUAL "")
        message(FATAL_ERROR "${ARGN}: expected ${expected}, got ${rc}, ${out} ${err}")
    endif()
endfunction()
run_ok(init)
run_ok(branch)
if(NOT output STREQUAL "* main (unborn)\n")
    message(FATAL_ERROR "unborn current branch missing: ${output}")
endif()
run_error(1 branch topic)
run_ok(config user.name Learner)
run_ok(config user.email learner@example.test)
file(WRITE "${repo}/note" "A\n")
run_ok(add note)
run_ok(commit -m first)
file(READ "${repo}/.minigit/refs/heads/main" first)
string(STRIP "${first}" first)
file(READ "${repo}/.minigit/HEAD" symbolic_head)
file(SHA256 "${repo}/.minigit/index" original_index)
file(SHA256 "${repo}/.minigit/logs/HEAD" original_head_log)
run_ok(branch topic)
run_ok(branch)
if(NOT output STREQUAL "* main ${first}\n  topic ${first}\n")
    message(FATAL_ERROR "branch sorting or current marker failed: ${output}")
endif()
run_ok(reflog topic)
if(NOT output STREQUAL "refs/heads/topic@{0} - -> ${first} branch:create\n")
    message(FATAL_ERROR "branch creation event missing: ${output}")
endif()
run_error(1 branch topic)
run_error(1 branch -f main)
run_error(1 branch -D main)
run_error(1 branch HEAD)
run_error(1 branch refs/heads/wrong)
run_error(1 branch ../escape)
run_error(2 branch --unknown)
run_error(2 branch -d topic extra)
run_error(2 branch -d -D topic)
run_error(2 branch -f -d topic)
run_error(2 branch -D -f topic)
run_error(2 branch -f)
run_ok(branch -- -label)
run_ok(branch -d -- -label)
# Existing topic blocks a nested namespace; no partial publication is permitted.
run_error(1 branch topic/sub)
run_ok(branch -d topic)
run_ok(branch topic/sub)
run_ok(branch -d topic/sub)
run_ok(branch topic)
file(SHA256 "${repo}/.minigit/index" observed_index)
file(SHA256 "${repo}/.minigit/logs/HEAD" observed_head_log)
file(READ "${repo}/.minigit/HEAD" observed_head)
if(NOT observed_index STREQUAL original_index OR NOT observed_head_log STREQUAL original_head_log OR NOT observed_head STREQUAL symbolic_head)
    message(FATAL_ERROR "branch metadata changes altered index or HEAD")
endif()
# Low-level fixture detaches at the same ID; the CLI creates a real divergent commit.
file(WRITE "${repo}/.minigit/HEAD" "${first}\n")
file(WRITE "${repo}/note" "B\n")
run_ok(add note)
run_ok(commit -m side)
file(READ "${repo}/.minigit/HEAD" side)
string(STRIP "${side}" side)
run_ok(branch side)
run_ok(branch)
if(output MATCHES "[*]")
    message(FATAL_ERROR "detached HEAD should not mark a current branch")
endif()
run_ok(branch -f topic)
run_ok(reflog topic)
if(NOT output MATCHES "^refs/heads/topic@[{]0[}] ${first} -> ${side} branch:update\n")
    message(FATAL_ERROR "forced branch move did not log old/new IDs: ${output}")
endif()
file(WRITE "${repo}/.minigit/HEAD" "${symbolic_head}")
file(WRITE "${repo}/note" "C\n")
file(SHA256 "${repo}/.minigit/index" divergent_index)
file(SHA256 "${repo}/.minigit/logs/HEAD" divergent_head_log)
run_error(1 branch -d side)
if(NOT EXISTS "${repo}/.minigit/refs/heads/side" OR NOT EXISTS "${repo}/.minigit/logs/refs/heads/side")
    message(FATAL_ERROR "unmerged deletion failure removed branch or its log")
endif()
run_ok(branch -D side)
if(EXISTS "${repo}/.minigit/refs/heads/side" OR EXISTS "${repo}/.minigit/logs/refs/heads/side")
    message(FATAL_ERROR "forced deletion did not remove ref and branch log together")
endif()
run_error(1 branch -d topic)
run_ok(branch -D topic)
run_ok(branch damaged)
file(WRITE "${repo}/.minigit/logs/refs/heads/damaged" "broken")
run_error(1 branch -D damaged)
file(READ "${repo}/.minigit/refs/heads/damaged" damaged_ref)
file(READ "${repo}/.minigit/logs/refs/heads/damaged" damaged_log)
file(SHA256 "${repo}/.minigit/index" observed_index)
file(SHA256 "${repo}/.minigit/logs/HEAD" observed_head_log)
file(READ "${repo}/.minigit/HEAD" observed_head)
file(READ "${repo}/note" observed_work)
if(NOT damaged_ref STREQUAL "${first}\n" OR NOT damaged_log STREQUAL "broken" OR NOT observed_index STREQUAL divergent_index OR NOT observed_head_log STREQUAL divergent_head_log OR NOT observed_head STREQUAL symbolic_head OR NOT observed_work STREQUAL "C\n" OR EXISTS "${repo}/.minigit/transaction")
    message(FATAL_ERROR "branch commands changed dirty work/index/HEAD or published corrupt log deletion")
endif()
file(REMOVE_RECURSE "${repo}")
