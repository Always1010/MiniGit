set(repo "${CMAKE_CURRENT_BINARY_DIR}/move-cli-repository")
file(REMOVE_RECURSE "${repo}")
file(MAKE_DIRECTORY "${repo}")
function(run_ok)
    execute_process(COMMAND "${MINIGIT}" ${ARGV} WORKING_DIRECTORY "${repo}"
        RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_VARIABLE err)
    if(NOT rc EQUAL 0 OR (ARGV0 STREQUAL "mv" AND NOT out STREQUAL ""))
        message(FATAL_ERROR "${ARGV}: ${rc} ${out} ${err}")
    endif()
    set(output "${out}" PARENT_SCOPE)
endfunction()
function(run_error expected)
    execute_process(COMMAND "${MINIGIT}" ${ARGN} WORKING_DIRECTORY "${repo}"
        RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_VARIABLE err)
    if(NOT rc EQUAL expected OR NOT out STREQUAL "")
        message(FATAL_ERROR "${ARGN}: expected ${expected}, got ${rc}, ${out} ${err}")
    endif()
endfunction()
function(expect_file path expected)
    file(READ "${repo}/${path}" observed)
    if(NOT observed STREQUAL expected)
        message(FATAL_ERROR "${path}: expected '${expected}', got '${observed}'")
    endif()
endfunction()
function(expect_index path expected)
    run_ok(show ":${path}")
    if(NOT output STREQUAL expected)
        message(FATAL_ERROR "index ${path}: expected '${expected}', got '${output}'")
    endif()
endfunction()
run_ok(init)
run_error(2 mv)
run_error(2 mv one)
run_error(2 mv one two three)
run_error(2 mv -f one two)
file(WRITE "${repo}/new" "unborn B\n")
run_ok(add new)
file(WRITE "${repo}/new" "unborn C\n")
run_ok(mv new unborn)
expect_index(unborn "unborn B\n")
expect_file(unborn "unborn C\n")
if(EXISTS "${repo}/new" OR EXISTS "${repo}/.minigit/refs/heads/main")
    message(FATAL_ERROR "unborn move kept source or created branch")
endif()
run_ok(config user.name Learner)
run_ok(config user.email learner@example.test)
file(WRITE "${repo}/note" "A\n")
file(WRITE "${repo}/-name" "option file\n")
run_ok(add note -- -name)
run_ok(commit -m A)
foreach(path IN ITEMS HEAD refs/heads/main logs/HEAD logs/refs/heads/main identity)
    file(SHA256 "${repo}/.minigit/${path}" before_${path})
endforeach()
# Move B and C independently instead of adding C under its new name.
file(WRITE "${repo}/note" "B\n")
run_ok(add note)
file(WRITE "${repo}/note" "C\n")
file(CHMOD "${repo}/note" PERMISSIONS OWNER_READ OWNER_WRITE OWNER_EXECUTE GROUP_READ GROUP_EXECUTE WORLD_READ WORLD_EXECUTE)
run_ok(mv note newparent/moved)
expect_index(newparent/moved "B\n")
expect_file(newparent/moved "C\n")
run_error(1 show :note)
if(EXISTS "${repo}/note")
    message(FATAL_ERROR "move kept original file")
endif()
run_ok(status --porcelain)
if(NOT output MATCHES "AM newparent/moved" OR NOT output MATCHES "D  note")
    message(FATAL_ERROR "move lost the staged/unstaged distinction: ${output}")
endif()
# An existing destination directory contributes the source basename.
file(MAKE_DIRECTORY "${repo}/box")
run_ok(mv newparent/moved box)
expect_index(box/moved "B\n")
expect_file(box/moved "C\n")
# Same bytes do not authorize overwriting an unknown destination.
file(WRITE "${repo}/collision" "C\n")
file(SHA256 "${repo}/.minigit/index" before_index)
run_error(1 mv box/moved collision)
expect_file(box/moved "C\n")
expect_file(collision "C\n")
file(SHA256 "${repo}/.minigit/index" after_index)
if(NOT before_index STREQUAL after_index)
    message(FATAL_ERROR "refused move changed the index")
endif()
file(WRITE "${repo}/vacant" "staged destination\n")
run_ok(add vacant)
file(REMOVE "${repo}/vacant")
run_error(1 mv box/moved vacant)
expect_index(vacant "staged destination\n")
expect_file(box/moved "C\n")
# Moving a tracked directory refuses unknown files and empty directories.
file(MAKE_DIRECTORY "${repo}/pack/sub")
file(WRITE "${repo}/pack/a" "a B\n")
file(WRITE "${repo}/pack/sub/b" "b B\n")
run_ok(add pack)
file(WRITE "${repo}/pack/sub/b" "b C\n")
file(WRITE "${repo}/.minigitignore" "pack/private\n")
file(WRITE "${repo}/pack/private" "private\n")
file(SHA256 "${repo}/.minigit/index" pack_index)
run_error(1 mv pack box)
expect_file(pack/private "private\n")
expect_file(pack/sub/b "b C\n")
file(SHA256 "${repo}/.minigit/index" observed_pack_index)
if(NOT pack_index STREQUAL observed_pack_index OR EXISTS "${repo}/box/pack")
    message(FATAL_ERROR "directory move partially published before refusal")
endif()
file(REMOVE "${repo}/pack/private")
file(MAKE_DIRECTORY "${repo}/pack/private-empty")
run_error(1 mv pack box)
if(NOT IS_DIRECTORY "${repo}/pack/private-empty")
    message(FATAL_ERROR "move deleted an unknown empty directory")
endif()
file(REMOVE_RECURSE "${repo}/pack/private-empty")
run_error(1 mv pack pack/sub/new)
run_ok(mv pack box)
expect_index(box/pack/a "a B\n")
expect_index(box/pack/sub/b "b B\n")
expect_file(box/pack/sub/b "b C\n")
if(EXISTS "${repo}/pack")
    message(FATAL_ERROR "directory move kept the source tree")
endif()
run_ok(mv -- -name -renamed)
expect_file(-renamed "option file\n")
expect_index(-renamed "option file\n")
foreach(path IN ITEMS HEAD refs/heads/main logs/HEAD logs/refs/heads/main identity)
    file(SHA256 "${repo}/.minigit/${path}" observed)
    if(NOT observed STREQUAL "${before_${path}}")
        message(FATAL_ERROR "mv changed unrelated metadata ${path}")
    endif()
endforeach()
if(EXISTS "${repo}/.minigit/transaction")
    message(FATAL_ERROR "mv left a transaction journal")
endif()
file(REMOVE_RECURSE "${repo}")
