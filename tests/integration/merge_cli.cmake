set(repo "${CMAKE_CURRENT_BINARY_DIR}/merge-cli-repository")
file(REMOVE_RECURSE "${repo}")
file(MAKE_DIRECTORY "${repo}")
function(run_ok)
    execute_process(COMMAND "${MINIGIT}" ${ARGV} WORKING_DIRECTORY "${repo}"
        RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_VARIABLE err)
    if(NOT rc EQUAL 0)
        message(FATAL_ERROR "${ARGV}: ${rc} ${out} ${err}")
    endif()
    set(output "${out}" PARENT_SCOPE)
endfunction()
function(run_error expected)
    execute_process(COMMAND "${MINIGIT}" ${ARGN} WORKING_DIRECTORY "${repo}"
        RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_VARIABLE err)
    if(NOT rc EQUAL expected OR NOT out STREQUAL "")
        message(FATAL_ERROR "${ARGN}: expected ${expected}, got ${rc}: ${out} ${err}")
    endif()
endfunction()
function(run_conflict)
    execute_process(COMMAND "${MINIGIT}" merge ${ARGV} WORKING_DIRECTORY "${repo}"
        RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_VARIABLE err)
    if(NOT rc EQUAL 1 OR NOT out MATCHES "Merge paused" OR NOT out MATCHES "CONFLICT note" OR NOT err STREQUAL "")
        message(FATAL_ERROR "merge ${ARGV}: expected published conflict: ${rc} ${out} ${err}")
    endif()
    if(NOT EXISTS "${repo}/.minigit/operation" OR EXISTS "${repo}/.minigit/transaction")
        message(FATAL_ERROR "merge did not publish a complete conflict state")
    endif()
endfunction()
function(head_id)
    run_ok(log -n 1)
    string(REGEX MATCH "^commit ([0-9a-f]+)\n" header "${output}")
    set(id "${CMAKE_MATCH_1}")
    string(LENGTH "${id}" length)
    if(NOT length EQUAL 64)
        message(FATAL_ERROR "expected a complete commit ID: ${output}")
    endif()
    set(id "${id}" PARENT_SCOPE)
endfunction()
function(expect_file path expected)
    file(READ "${repo}/${path}" actual)
    if(NOT actual STREQUAL expected)
        message(FATAL_ERROR "${path}: expected '${expected}', got '${actual}'")
    endif()
endfunction()
function(expect_parents left right)
    head_id()
    run_ok(cat-file -p "${id}")
    string(FIND "${output}" "parent ${left}\nparent ${right}\n" position)
    if(position LESS 0)
        message(FATAL_ERROR "merge lost its ordered parents: ${output}")
    endif()
endfunction()
run_ok(init)
foreach(arguments IN ITEMS "merge" "merge --continue --abort" "merge --continue HEAD" "merge --abort -m nope" "merge -m" "merge HEAD HEAD" "merge --unknown" "merge -m a -m b HEAD")
    separate_arguments(tokens UNIX_COMMAND "${arguments}")
    run_error(2 ${tokens})
endforeach()
run_error(1 merge --continue)
run_error(1 merge --abort)
run_ok(config user.name Learner)
run_ok(config user.email learner@example.test)
file(WRITE "${repo}/note" "first\nmiddle\nlast\n")
run_ok(add note)
run_ok(commit -m base)
run_ok(switch -c topic)
file(WRITE "${repo}/note" "first\nmiddle\ntheirs-last\n")
run_ok(add note)
run_ok(commit -m theirs)
head_id()
set(theirs "${id}")
run_ok(switch main)
file(WRITE "${repo}/note" "ours-first\nmiddle\nlast\n")
run_ok(add note)
run_ok(commit -m ours)
head_id()
set(ours "${id}")
run_ok(merge -m combine topic)
if(NOT output MATCHES "^Merged ")
    message(FATAL_ERROR "expected a merge commit: ${output}")
endif()
expect_file(note "ours-first\nmiddle\ntheirs-last\n")
expect_parents("${ours}" "${theirs}")
run_ok(status --porcelain)
if(NOT output STREQUAL "" OR EXISTS "${repo}/.minigit/operation")
    message(FATAL_ERROR "clean merge left state or dirty trees")
endif()
head_id()
set(merged "${id}")
file(SHA256 "${repo}/.minigit/index" old_index)
run_ok(merge topic)
if(NOT output STREQUAL "Already up to date.\n")
    message(FATAL_ERROR "expected up-to-date output: ${output}")
endif()
head_id()
file(SHA256 "${repo}/.minigit/index" new_index)
if(NOT id STREQUAL merged OR NOT old_index STREQUAL new_index)
    message(FATAL_ERROR "up-to-date merge changed metadata")
endif()
# Fast-forward must protect an unknown file and even an unknown empty directory.
run_ok(switch -c forward)
file(WRITE "${repo}/fresh" "incoming\n")
run_ok(add fresh)
run_ok(commit -m forward)
head_id()
set(forward "${id}")
run_ok(switch main)
file(WRITE "${repo}/fresh" "private\n")
run_error(1 merge forward)
expect_file(fresh "private\n")
file(REMOVE "${repo}/fresh")
file(MAKE_DIRECTORY "${repo}/fresh")
run_error(1 merge forward)
if(NOT IS_DIRECTORY "${repo}/fresh")
    message(FATAL_ERROR "refused merge lost an empty directory")
endif()
file(REMOVE_RECURSE "${repo}/fresh")
run_ok(merge forward)
if(NOT output STREQUAL "Fast-forward ${forward}\n")
    message(FATAL_ERROR "expected fast-forward: ${output}")
endif()
expect_file(fresh "incoming\n")
head_id()
if(NOT id STREQUAL forward)
    message(FATAL_ERROR "fast-forward created a replacement commit")
endif()
# Conflict continuation creates a two-parent commit from Index, preserving C.
run_ok(switch -c clash)
file(WRITE "${repo}/note" "incoming conflict\n")
run_ok(add note)
run_ok(commit -m clash)
head_id()
set(clash "${id}")
run_ok(switch main)
file(WRITE "${repo}/note" "ours conflict\n")
run_ok(add note)
run_ok(commit -m original)
head_id()
set(original "${id}")
file(CHMOD "${repo}/note" PERMISSIONS OWNER_READ OWNER_WRITE GROUP_READ)
file(SHA256 "${repo}/.minigit/index" original_index)
run_conflict(-m resolution clash)
run_ok(status --porcelain)
if(NOT output MATCHES "UU note")
    message(FATAL_ERROR "conflict stages were not visible: ${output}")
endif()
run_error(1 commit -m forbidden)
run_error(1 switch clash)
run_error(1 reset --hard)
run_error(1 branch during)
run_error(1 merge --continue)
file(WRITE "${repo}/note" "staged resolution\n")
run_ok(add note)
file(WRITE "${repo}/note" "unstaged after resolution\n")
run_ok(merge --continue)
expect_parents("${original}" "${clash}")
expect_file(note "unstaged after resolution\n")
run_ok(show HEAD:note)
if(NOT output STREQUAL "staged resolution\n")
    message(FATAL_ERROR "continuation committed unstaged content: ${output}")
endif()
if(EXISTS "${repo}/.minigit/operation")
    message(FATAL_ERROR "continuation retained operation state")
endif()
run_error(1 merge --continue)
run_error(1 merge --abort)
# A solved File->Directory conversion is reversible; a new unknown child blocks
# the entire abort. The known child is removed, not left under restored File.
run_ok(reset --hard "${original}")
file(CHMOD "${repo}/note" PERMISSIONS OWNER_READ OWNER_WRITE GROUP_READ)
run_conflict(clash)
run_ok(rm --cached -f note)
file(REMOVE "${repo}/note")
file(MAKE_DIRECTORY "${repo}/note")
file(WRITE "${repo}/note/resolved" "new tracked child\n")
run_ok(add note)
file(WRITE "${repo}/note/private" "new unknown child\n")
foreach(path IN ITEMS HEAD index operation refs/heads/main logs/HEAD logs/refs/heads/main)
    file(SHA256 "${repo}/.minigit/${path}" before_${path})
endforeach()
run_error(1 merge --abort)
foreach(path IN ITEMS HEAD index operation refs/heads/main logs/HEAD logs/refs/heads/main)
    file(SHA256 "${repo}/.minigit/${path}" after_${path})
    if(NOT before_${path} STREQUAL after_${path})
        message(FATAL_ERROR "refused abort changed ${path}")
    endif()
endforeach()
expect_file(note/private "new unknown child\n")
expect_file(note/resolved "new tracked child\n")
file(REMOVE "${repo}/note/private")
run_ok(merge --abort)
expect_file(note "ours conflict\n")
execute_process(COMMAND stat -c %a "${repo}/note" RESULT_VARIABLE rc OUTPUT_VARIABLE mode OUTPUT_STRIP_TRAILING_WHITESPACE)
if(NOT rc EQUAL 0 OR NOT mode STREQUAL "640")
    message(FATAL_ERROR "abort lost original full permissions: ${mode}")
endif()
file(SHA256 "${repo}/.minigit/index" restored_index)
head_id()
if(NOT id STREQUAL original OR NOT original_index STREQUAL restored_index OR EXISTS "${repo}/.minigit/operation")
    message(FATAL_ERROR "abort did not restore exact Index and logical HEAD")
endif()
# Logical HEAD equality does not imply exact byte equality.
run_ok(switch --detach "${original}")
string(TOUPPER "${original}" uppercase)
file(WRITE "${repo}/.minigit/HEAD" "${uppercase}\n")
run_conflict(clash)
file(WRITE "${repo}/.minigit/HEAD" "${original}\n")
run_ok(merge --abort)
expect_file(.minigit/HEAD "${uppercase}\n")
expect_file(note "ours conflict\n")
