set(repo "${CMAKE_CURRENT_BINARY_DIR}/recovery-cli-repository")
file(REMOVE_RECURSE "${repo}")
file(MAKE_DIRECTORY "${repo}")
function(run_ok)
    execute_process(COMMAND "${MINIGIT}" ${ARGV} WORKING_DIRECTORY "${repo}"
        RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_VARIABLE err)
    if(NOT rc EQUAL 0)
        message(FATAL_ERROR "${ARGV}: ${rc} ${err}")
    endif()
    set(output "${out}" PARENT_SCOPE)
endfunction()
function(run_error expected)
    execute_process(COMMAND "${MINIGIT}" ${ARGN} WORKING_DIRECTORY "${repo}"
        RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_VARIABLE err)
    if(NOT rc EQUAL expected OR NOT out STREQUAL "")
        message(FATAL_ERROR "${ARGN}: expected ${expected}, got ${rc}, stdout ${out}, stderr ${err}")
    endif()
endfunction()
run_ok(init)
run_ok(config user.name Learner)
run_ok(config user.email learner@example.test)
file(WRITE "${repo}/note" "preserved\n")
run_ok(add note)
run_ok(commit -m baseline)
run_ok(hash-object note)
string(STRIP "${output}" blob)
file(READ "${repo}/.minigit/HEAD" head)
file(READ "${repo}/.minigit/refs/heads/main" main)
file(SHA256 "${repo}/.minigit/index" index_hash)
run_ok(recover)
run_ok(recover)
run_error(2 recover --force)
file(WRITE "${repo}/.minigit/transaction" "damaged journal")
foreach(args IN ITEMS "status" "log" "reflog" "branch" "branch;blocked" "switch;main" "switch;-c;blocked" "restore;note" "restore;--staged;note" "diff" "show" "show;HEAD:note" "commit;-m;blocked" "add;note" "config;user.name;Blocked" "config;user.name" "tag" "tag;blocked" "hash-object;-w;note" "recover")
    run_error(1 ${args})
endforeach()
run_ok(show "${blob}")
if(NOT output STREQUAL "preserved\n")
    message(FATAL_ERROR "raw blob inspection should remain available during recovery")
endif()
run_ok(cat-file -p "${blob}")
if(NOT output STREQUAL "preserved\n")
    message(FATAL_ERROR "raw cat-file should remain available during recovery")
endif()
file(READ "${repo}/.minigit/HEAD" observed_head)
file(READ "${repo}/.minigit/refs/heads/main" observed_main)
file(SHA256 "${repo}/.minigit/index" observed_index_hash)
file(READ "${repo}/note" note)
file(READ "${repo}/.minigit/transaction" journal)
if(NOT observed_head STREQUAL head OR NOT observed_main STREQUAL main OR NOT observed_index_hash STREQUAL index_hash OR NOT note STREQUAL "preserved\n" OR NOT journal STREQUAL "damaged journal")
    message(FATAL_ERROR "rejected queries or recovery modified the preserved state")
endif()
file(REMOVE "${repo}/.minigit/transaction")
file(MAKE_DIRECTORY "${repo}/.minigit/transaction-staging")
file(WRITE "${repo}/.minigit/transaction-staging/unknown" "preserve")
run_error(1 status)
run_error(1 recover)
file(READ "${repo}/.minigit/transaction-staging/unknown" unknown)
if(NOT unknown STREQUAL "preserve")
    message(FATAL_ERROR "orphan staging recovery deleted an unknown file")
endif()
file(REMOVE_RECURSE "${repo}")
