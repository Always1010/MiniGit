set(repo "${CMAKE_CURRENT_BINARY_DIR}/stash-cli-repository")
file(REMOVE_RECURSE "${repo}")
file(MAKE_DIRECTORY "${repo}")
function(run_ok)
    execute_process(COMMAND "${MINIGIT}" ${ARGV} WORKING_DIRECTORY "${repo}"
        RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_VARIABLE err)
    if(NOT rc EQUAL 0)
        message(FATAL_ERROR "${ARGV}: ${rc} ${out} ${err}")
    endif()
    set(output "${out}" PARENT_SCOPE)
endfunction()
function(run_error expected)
    execute_process(COMMAND "${MINIGIT}" ${ARGN} WORKING_DIRECTORY "${repo}"
        RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_VARIABLE err)
    if(NOT rc EQUAL expected OR NOT out STREQUAL "")
        message(FATAL_ERROR "${ARGN}: expected ${expected}, got ${rc}: ${out} ${err}")
    endif()
endfunction()
function(expect_file path expected)
    file(READ "${repo}/${path}" actual)
    if(NOT actual STREQUAL expected)
        message(FATAL_ERROR "${path}: expected '${expected}', got '${actual}'")
    endif()
endfunction()
function(head_id)
    run_ok(log -n 1)
    string(REGEX MATCH "^commit ([0-9a-f]+)\n" header "${output}")
    set(id "${CMAKE_MATCH_1}")
    string(LENGTH "${id}" length)
    if(NOT length EQUAL 64)
        message(FATAL_ERROR "expected a complete commit ID: ${output}")
    endif()
    set(id "${id}" PARENT_SCOPE)
endfunction()
function(top_id)
    file(READ "${repo}/.minigit/refs/stash" ref)
    string(STRIP "${ref}" id)
    string(LENGTH "${id}" length)
    if(NOT length EQUAL 64)
        message(FATAL_ERROR "expected complete stash ID")
    endif()
    set(id "${id}" PARENT_SCOPE)
endfunction()
run_ok(init)
run_ok(stash list)
if(NOT output STREQUAL "")
    message(FATAL_ERROR "unborn stash list should be empty")
endif()
run_ok(stash clear)
run_error(1 stash)
run_error(1 stash show)
run_error(1 stash drop)
run_error(2 stash push -u --include-untracked)
run_error(2 stash push -m)
run_error(2 stash push -m one -m two)
run_error(2 stash push path)
run_error(2 stash list extra)
run_error(2 stash clear extra)
run_error(2 stash show "stash@{-1}")
run_error(2 stash drop "stash@{}")
run_error(2 stash show 1)
run_error(2 stash show "stash@{0}" "stash@{1}")
run_error(2 stash apply --unknown)
run_ok(config user.name Learner)
run_ok(config user.email learner@example.test)
file(WRITE "${repo}/f" "A\n")
file(WRITE "${repo}/remove" "old\n")
file(WRITE "${repo}/.minigitignore" "ignored\n")
run_ok(add -A)
run_ok(commit -m base)
head_id()
set(base "${id}")
file(SHA256 "${repo}/.minigit/HEAD" head_before)
file(SHA256 "${repo}/.minigit/logs/HEAD" log_before)
file(WRITE "${repo}/f" "B\n")
file(WRITE "${repo}/added" "staged add\n")
run_ok(add f added)
run_ok(rm --cached remove)
file(WRITE "${repo}/f" "C\n")
file(WRITE "${repo}/added" "work add\n")
file(REMOVE "${repo}/remove")
file(WRITE "${repo}/unknown" "unknown bytes\n")
file(WRITE "${repo}/ignored" "ignored bytes\n")
run_ok(stash push -m "first\nmessage")
if(NOT output MATCHES "^Saved stash ")
    message(FATAL_ERROR "stash did not report save")
endif()
top_id()
set(first "${id}")
expect_file(f "A\n")
expect_file(remove "old\n")
expect_file(unknown "unknown bytes\n")
expect_file(ignored "ignored bytes\n")
if(EXISTS "${repo}/added")
    message(FATAL_ERROR "staged added Work was not cleaned")
endif()
run_ok(cat-file -p "${first}")
string(REGEX MATCH "parent ([0-9a-f]+)\nparent ([0-9a-f]+)\n" parents "${output}")
if(NOT CMAKE_MATCH_1 STREQUAL base)
    message(FATAL_ERROR "stash did not retain original HEAD parent")
endif()
set(index_commit "${CMAKE_MATCH_2}")
run_ok(show "${index_commit}:f")
if(NOT output STREQUAL "B\n")
    message(FATAL_ERROR "stash Index lost staged version")
endif()
run_ok(show "${first}:f")
if(NOT output STREQUAL "C\n")
    message(FATAL_ERROR "stash Work lost later edit")
endif()
run_ok(show "${index_commit}:added")
if(NOT output STREQUAL "staged add\n")
    message(FATAL_ERROR "stash Index lost staged addition")
endif()
run_ok(show "${first}:added")
if(NOT output STREQUAL "work add\n")
    message(FATAL_ERROR "stash Work lost unstaged addition edit")
endif()
run_error(1 show "${first}:remove")
run_error(1 show "${index_commit}:remove")
run_error(1 show "${first}:unknown")
run_ok(stash show)
if(NOT output MATCHES "\\+C" OR NOT output MATCHES "\\+work add" OR output MATCHES "unknown bytes")
    message(FATAL_ERROR "stash show did not render HEAD to saved Work")
endif()
run_ok(stash list)
string(FIND "${output}" "\"first\\nmessage\"" message_position)
if(message_position LESS 0)
    message(FATAL_ERROR "stash list did not escape message newline: ${output}")
endif()
file(SHA256 "${repo}/.minigit/stashstack" stack_before)
file(SHA256 "${repo}/.minigit/index" index_before)
run_ok(stash)
if(NOT output STREQUAL "No local changes to save.\n")
    message(FATAL_ERROR "default stash should be no-op with only untracked changes")
endif()
file(SHA256 "${repo}/.minigit/stashstack" stack_after)
file(SHA256 "${repo}/.minigit/index" index_after)
if(NOT stack_before STREQUAL stack_after OR NOT index_before STREQUAL index_after)
    message(FATAL_ERROR "no-op rewrote stack or Index")
endif()
file(WRITE "${repo}/f" "D\n")
run_ok(stash push --include-untracked -m second)
top_id()
set(second "${id}")
expect_file(f "A\n")
expect_file(ignored "ignored bytes\n")
if(EXISTS "${repo}/unknown")
    message(FATAL_ERROR "-u did not clean saved untracked file")
endif()
run_ok(cat-file -p "${second}")
string(REGEX MATCH "parent ([0-9a-f]+)\nparent ([0-9a-f]+)\nparent ([0-9a-f]+)\n" parents "${output}")
set(untracked_commit "${CMAKE_MATCH_3}")
run_ok(show "${untracked_commit}:unknown")
if(NOT output STREQUAL "unknown bytes\n")
    message(FATAL_ERROR "-u did not save independent untracked Snapshot")
endif()
run_error(1 show "${second}:unknown")
run_ok(stash show -- "stash@{0}")
if(NOT output MATCHES "\\+D" OR NOT output MATCHES "\\+unknown bytes")
    message(FATAL_ERROR "stash show omitted -u content")
endif()
file(COPY_FILE "${repo}/.minigit/index" "${repo}/index.saved")
file(WRITE "${repo}/.minigit/index" "broken Index")
file(REMOVE "${repo}/f")
execute_process(COMMAND mkfifo "${repo}/f" RESULT_VARIABLE fifo_rc)
if(NOT fifo_rc EQUAL 0)
    message(FATAL_ERROR "failed to create unsupported Work node")
endif()
run_ok(stash list)
if(NOT output MATCHES "stash@\\{0\\} ${second}" OR NOT output MATCHES "stash@\\{1\\} ${first}")
    message(FATAL_ERROR "stash stack order is wrong")
endif()
run_ok(stash show "stash@{1}")
file(SHA256 "${repo}/.minigit/refs/stash" ref_before)
run_ok(stash drop "stash@{1}")
file(SHA256 "${repo}/.minigit/refs/stash" ref_after)
if(NOT ref_before STREQUAL ref_after)
    message(FATAL_ERROR "middle drop changed current top")
endif()
run_ok(stash clear)
if(EXISTS "${repo}/.minigit/stashstack" OR EXISTS "${repo}/.minigit/refs/stash")
    message(FATAL_ERROR "clear did not remove stack pair")
endif()
expect_file(.minigit/index "broken Index")
file(SHA256 "${repo}/.minigit/HEAD" head_after)
file(SHA256 "${repo}/.minigit/logs/HEAD" log_after)
if(NOT head_before STREQUAL head_after OR NOT log_before STREQUAL log_after)
    message(FATAL_ERROR "stash save/drop moved HEAD or created history log")
endif()
file(COPY_FILE "${repo}/index.saved" "${repo}/.minigit/index")
file(REMOVE "${repo}/index.saved" "${repo}/f")
file(WRITE "${repo}/f" "guard stash\n")
run_ok(stash push)
run_ok(switch -c source)
file(WRITE "${repo}/f" "source\n")
run_ok(add f)
run_ok(commit -m source)
run_ok(switch main)
file(WRITE "${repo}/f" "ours\n")
run_ok(add f)
run_ok(commit -m ours)
execute_process(COMMAND "${MINIGIT}" merge source WORKING_DIRECTORY "${repo}" RESULT_VARIABLE conflict)
if(NOT conflict EQUAL 1 OR NOT EXISTS "${repo}/.minigit/operation")
    message(FATAL_ERROR "expected active conflict")
endif()
run_ok(stash list)
run_ok(stash show)
run_error(1 stash push)
run_error(1 stash drop)
run_error(1 stash clear)
run_ok(merge --abort)
run_ok(stash clear)
run_ok(stash list)
if(NOT output STREQUAL "")
    message(FATAL_ERROR "final stack should be empty")
endif()
