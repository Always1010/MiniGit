set(repo "${CMAKE_CURRENT_BINARY_DIR}/status-cli-repository")
file(REMOVE_RECURSE "${repo}")
file(MAKE_DIRECTORY "${repo}")
function(run_ok)
    execute_process(COMMAND "${MINIGIT}" ${ARGV} WORKING_DIRECTORY "${repo}"
        RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_VARIABLE err)
    if(NOT rc EQUAL 0)
        message(FATAL_ERROR "${ARGV}: ${rc} ${err}")
    endif()
    set(output "${out}" PARENT_SCOPE)
endfunction()
function(expect_status expected)
    run_ok(status --porcelain)
    if(NOT output STREQUAL expected)
        message(FATAL_ERROR "status expected [${expected}], got [${output}]")
    endif()
endfunction()
run_ok(init)
expect_status("")
run_ok(status)
if(NOT output MATCHES "On branch main\nNo commits yet\nworking tree clean\n")
    message(FATAL_ERROR "unborn status missing context")
endif()
run_ok(config user.name Learner)
run_ok(config user.email learner@example.test)
file(WRITE "${repo}/note" "A\n")
expect_status("?? note\n")
run_ok(add note)
expect_status("A  note\n")
file(WRITE "${repo}/note" "B\n")
expect_status("AM note\n")
run_ok(commit -m "save A")
expect_status(" M note\n")
run_ok(add note)
file(WRITE "${repo}/note" "C\n")
expect_status("MM note\n")
run_ok(commit -m "save B")
file(REMOVE "${repo}/note")
expect_status(" D note\n")
run_ok(add note)
expect_status("D  note\n")
run_ok(commit -m "delete note")
expect_status("")
file(WRITE "${repo}/space name" "untracked\n")
expect_status("?? \"space name\"\n")
execute_process(COMMAND "${MINIGIT}" status -s WORKING_DIRECTORY "${repo}"
    RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_VARIABLE err)
if(NOT rc EQUAL 0 OR NOT out STREQUAL "?? \"space name\"\n")
    message(FATAL_ERROR "status short alias failed")
endif()
execute_process(COMMAND "${MINIGIT}" status --invalid WORKING_DIRECTORY "${repo}"
    RESULT_VARIABLE rc ERROR_VARIABLE err)
if(NOT rc EQUAL 2)
    message(FATAL_ERROR "unknown status option accepted")
endif()
file(REMOVE_RECURSE "${repo}")
