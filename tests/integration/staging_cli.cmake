set(repo "${CMAKE_CURRENT_BINARY_DIR}/staging-cli-repository")
file(REMOVE_RECURSE "${repo}")
file(MAKE_DIRECTORY "${repo}")
function(run_ok)
    execute_process(COMMAND "${MINIGIT}" ${ARGV} WORKING_DIRECTORY "${repo}"
        RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_VARIABLE err)
    if(NOT rc EQUAL 0)
        message(FATAL_ERROR "${ARGV}: ${rc} ${err}")
    endif()
    set(output "${out}" PARENT_SCOPE)
endfunction()
run_ok(init)
file(WRITE "${repo}/note.txt" "staged\n")
run_ok(add note.txt)
if(NOT EXISTS "${repo}/.minigit/index")
    message(FATAL_ERROR "add did not persist index")
endif()
run_ok(hash-object note.txt)
string(STRIP "${output}" staged_id)
file(WRITE "${repo}/note.txt" "working\n")
run_ok(cat-file -p "${staged_id}")
if(NOT output STREQUAL "staged\n")
    message(FATAL_ERROR "add did not store the staged blob")
endif()
file(MAKE_DIRECTORY "${repo}/sub")
file(WRITE "${repo}/sub/empty.txt" "")
execute_process(COMMAND "${MINIGIT}" add empty.txt WORKING_DIRECTORY "${repo}/sub"
    RESULT_VARIABLE rc ERROR_VARIABLE err)
if(NOT rc EQUAL 0)
    message(FATAL_ERROR "subdirectory add failed: ${err}")
endif()
file(SHA256 "${repo}/.minigit/index" index_before)
execute_process(COMMAND "${MINIGIT}" add missing.txt WORKING_DIRECTORY "${repo}"
    RESULT_VARIABLE rc ERROR_VARIABLE err)
file(SHA256 "${repo}/.minigit/index" index_after)
if(NOT rc EQUAL 1 OR NOT index_after STREQUAL index_before)
    message(FATAL_ERROR "failed add changed index")
endif()
file(REMOVE "${repo}/note.txt")
run_ok(add note.txt)
file(WRITE "${repo}/new.txt" "new\n")
run_ok(add -A)
execute_process(COMMAND "${MINIGIT}" add WORKING_DIRECTORY "${repo}"
    RESULT_VARIABLE rc ERROR_VARIABLE err)
if(NOT rc EQUAL 2)
    message(FATAL_ERROR "add accepted empty arguments")
endif()
file(REMOVE_RECURSE "${repo}")
