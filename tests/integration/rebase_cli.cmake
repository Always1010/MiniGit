set(repo "${CMAKE_CURRENT_BINARY_DIR}/rebase-cli-repository")
function(fresh_repo suffix)
    set(repo "${CMAKE_CURRENT_BINARY_DIR}/rebase-cli-${suffix}" PARENT_SCOPE)
    file(REMOVE_RECURSE "${CMAKE_CURRENT_BINARY_DIR}/rebase-cli-${suffix}")
    file(MAKE_DIRECTORY "${CMAKE_CURRENT_BINARY_DIR}/rebase-cli-${suffix}")
endfunction()
function(run_ok)
    execute_process(COMMAND "${MINIGIT}" ${ARGV} WORKING_DIRECTORY "${repo}"
        RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_VARIABLE err)
    if(NOT rc EQUAL 0)
        message(FATAL_ERROR "${ARGV}: ${rc} ${out} ${err}")
    endif()
    set(output "${out}" PARENT_SCOPE)
endfunction()
function(run_error expected)
    execute_process(COMMAND "${MINIGIT}" ${ARGN} WORKING_DIRECTORY "${repo}"
        RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_VARIABLE err)
    if(NOT rc EQUAL expected OR NOT out STREQUAL "")
        message(FATAL_ERROR "${ARGN}: expected ${expected}, got ${rc}: ${out} ${err}")
    endif()
endfunction()
function(head_id)
    run_ok(log -n 1)
    string(REGEX MATCH "^commit ([0-9a-f]+)\n" header "${output}")
    string(LENGTH "${CMAKE_MATCH_1}" length)
    if(NOT length EQUAL 64)
        message(FATAL_ERROR "expected a complete commit ID: ${output}")
    endif()
    set(id "${CMAKE_MATCH_1}" PARENT_SCOPE)
endfunction()
function(expect_file path expected)
    file(READ "${repo}/${path}" actual)
    if(NOT actual STREQUAL expected)
        message(FATAL_ERROR "${path}: expected '${expected}', got '${actual}'")
    endif()
endfunction()
function(expect_rewritten revision message)
    run_ok(cat-file -p "${revision}")
    if(NOT output MATCHES "author Source <source@example.test>" OR
       NOT output MATCHES "committer Receiver <receiver@example.test>")
        message(FATAL_ERROR "lost source author/current committer: ${output}")
    endif()
    string(REGEX MATCHALL "parent [0-9a-f]+\n" parents "${output}")
    list(LENGTH parents count)
    string(FIND "${output}" "\n\n${message}" message_position)
    if(NOT count EQUAL 1 OR message_position LESS 0)
        message(FATAL_ERROR "wrong parent count/message: ${output}")
    endif()
    string(REGEX MATCH "\nparent ([0-9a-f]+)\n" parent "${output}")
    set(parent_id "${CMAKE_MATCH_1}" PARENT_SCOPE)
endfunction()
function(expect_conflict)
    execute_process(COMMAND "${MINIGIT}" rebase main WORKING_DIRECTORY "${repo}"
        RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_VARIABLE err)
    if(NOT rc EQUAL 1 OR NOT out MATCHES "Rebase paused" OR
       NOT out MATCHES "CONFLICT note" OR NOT err STREQUAL "")
        message(FATAL_ERROR "expected a published rebase conflict: ${rc} ${out} ${err}")
    endif()
    if(NOT EXISTS "${repo}/.minigit/operation" OR EXISTS "${repo}/.minigit/transaction")
        message(FATAL_ERROR "incomplete rebase publication")
    endif()
endfunction()

fresh_repo(clean)
run_ok(init)
foreach(arguments IN ITEMS "--continue" "--abort")
    run_error(1 rebase "${arguments}")
endforeach()
run_error(2 rebase)
run_error(2 rebase --continue --abort)
run_error(2 rebase --continue HEAD)
run_error(2 rebase --abort HEAD)
run_error(2 rebase --message unwanted HEAD)
run_error(2 rebase --onto HEAD main)
run_error(2 rebase --interactive HEAD)
run_error(2 rebase --skip)
run_error(2 rebase HEAD HEAD)
run_ok(config user.name Source)
run_ok(config user.email source@example.test)
file(WRITE "${repo}/note" "base\n")
run_ok(add note)
run_ok(commit -m base)
head_id()
set(base "${id}")
run_ok(switch -c topic)
file(WRITE "${repo}/note" "topic\n")
run_ok(add note)
run_ok(commit -m topic-first)
file(WRITE "${repo}/extra" "topic extra\n")
run_ok(add extra)
run_ok(commit -m topic-second)
head_id()
set(original_tip "${id}")
run_ok(switch main)
file(WRITE "${repo}/onto" "main only\n")
run_ok(add onto)
run_ok(commit -m main)
head_id()
set(onto "${id}")
run_ok(switch topic)
run_ok(config user.name Receiver)
run_ok(config user.email receiver@example.test)
run_ok(rebase -- main)
head_id()
set(rewritten_tip "${id}")
if(rewritten_tip STREQUAL original_tip OR EXISTS "${repo}/.minigit/operation")
    message(FATAL_ERROR "linear rebase did not finish")
endif()
expect_rewritten("${rewritten_tip}" topic-second)
set(rewritten_first "${parent_id}")
expect_rewritten("${rewritten_first}" topic-first)
if(NOT parent_id STREQUAL onto)
    message(FATAL_ERROR "queue was not replayed oldest first onto main")
endif()
expect_file(.minigit/HEAD "ref: refs/heads/topic\n")
expect_file(.minigit/refs/heads/topic "${rewritten_tip}\n")
expect_file(.minigit/refs/heads/main "${onto}\n")
expect_file(note "topic\n")
expect_file(extra "topic extra\n")
expect_file(onto "main only\n")
run_ok(status --porcelain)
if(NOT output STREQUAL "")
    message(FATAL_ERROR "completed rebase is not clean: ${output}")
endif()
# Trivial outcomes neither create an operation nor require a new committer.
file(REMOVE "${repo}/.minigit/identity")
run_ok(rebase main)
if(NOT output STREQUAL "Already up to date.\n")
    message(FATAL_ERROR "expected an up-to-date result: ${output}")
endif()
head_id()
if(NOT id STREQUAL rewritten_tip)
    message(FATAL_ERROR "up-to-date rebase rewrote history")
endif()
run_ok(switch -c fast "${base}")
run_ok(rebase main)
expect_file(.minigit/refs/heads/fast "${onto}\n")
expect_file(.minigit/HEAD "ref: refs/heads/fast\n")
if(EXISTS "${repo}/.minigit/operation")
    message(FATAL_ERROR "fast-forward left an operation")
endif()

fresh_repo(conflict)
run_ok(init)
run_ok(config user.name Source)
run_ok(config user.email source@example.test)
file(WRITE "${repo}/note" "base\n")
run_ok(add note)
run_ok(commit -m base)
run_ok(switch -c topic)
file(WRITE "${repo}/first" "first change\n")
run_ok(add first)
run_ok(commit -m first-source)
file(WRITE "${repo}/note" "topic\n")
run_ok(add note)
run_ok(commit -m conflict-source)
head_id()
set(original_tip "${id}")
run_ok(switch main)
file(WRITE "${repo}/note" "onto\n")
run_ok(add note)
run_ok(commit -m main)
head_id()
set(onto "${id}")
run_ok(switch topic)
run_ok(config user.name Receiver)
run_ok(config user.email receiver@example.test)
file(CHMOD "${repo}/note" PERMISSIONS OWNER_READ OWNER_WRITE GROUP_READ)
file(SHA256 "${repo}/.minigit/index" original_index)
file(READ "${repo}/.minigit/HEAD" original_head)
file(WRITE "${repo}/unknown" "outside\n")
expect_conflict()
expect_file(.minigit/refs/heads/topic "${original_tip}\n")
expect_file(.minigit/refs/heads/main "${onto}\n")
run_ok(show :1:note)
if(NOT output STREQUAL "base\n")
    message(FATAL_ERROR "wrong source parent stage")
endif()
run_ok(show :2:note)
if(NOT output STREQUAL "onto\n")
    message(FATAL_ERROR "wrong current onto stage")
endif()
run_ok(show :3:note)
if(NOT output STREQUAL "topic\n")
    message(FATAL_ERROR "wrong source stage")
endif()
run_error(1 rebase --continue)
run_error(1 merge --continue)
run_error(1 cherry-pick --abort)
run_error(1 commit -m blocked)
file(WRITE "${repo}/note" "edited marker\n")
run_ok(rebase --abort)
expect_file(note "topic\n")
expect_file(first "first change\n")
expect_file(unknown "outside\n")
expect_file(.minigit/HEAD "${original_head}")
expect_file(.minigit/refs/heads/topic "${original_tip}\n")
file(SHA256 "${repo}/.minigit/index" restored_index)
execute_process(COMMAND stat -c %a "${repo}/note" RESULT_VARIABLE rc OUTPUT_VARIABLE mode OUTPUT_STRIP_TRAILING_WHITESPACE)
if(NOT original_index STREQUAL restored_index OR NOT rc EQUAL 0 OR NOT mode STREQUAL "640" OR EXISTS "${repo}/.minigit/operation")
    message(FATAL_ERROR "multi-step abort lost raw Index, permissions or state cleanup")
endif()
expect_conflict()
head_id()
set(rewritten_first "${id}")
file(WRITE "${repo}/note" "staged resolution\n")
run_ok(add note)
# The last conflicted source is committed from Index; Work need not be readable.
file(REMOVE "${repo}/note")
execute_process(COMMAND mkfifo "${repo}/note" RESULT_VARIABLE rc)
if(NOT rc EQUAL 0)
    message(FATAL_ERROR "could not create FIFO fixture")
endif()
run_ok(rebase --continue)
head_id()
expect_rewritten("${id}" conflict-source)
if(NOT parent_id STREQUAL rewritten_first)
    message(FATAL_ERROR "continued rebase lost its rewritten parent")
endif()
run_ok(show HEAD:note)
if(NOT output STREQUAL "staged resolution\n" OR EXISTS "${repo}/.minigit/operation")
    message(FATAL_ERROR "continue did not use resolved Index")
endif()
execute_process(COMMAND stat -c %F "${repo}/note" OUTPUT_VARIABLE node_kind OUTPUT_STRIP_TRAILING_WHITESPACE)
if(NOT node_kind STREQUAL "fifo")
    message(FATAL_ERROR "last continue changed unreadable Work")
endif()
file(REMOVE "${repo}/note")

fresh_repo(ready)
run_ok(init)
run_ok(config user.name Source)
run_ok(config user.email source@example.test)
file(WRITE "${repo}/note" "base\n")
run_ok(add note)
run_ok(commit -m base)
run_ok(switch -c topic)
file(WRITE "${repo}/transient" "source transient\n")
run_ok(add transient)
run_ok(commit -m transient-source)
run_ok(rm transient)
file(WRITE "${repo}/note" "final topic\n")
run_ok(add note)
run_ok(commit -m final-source)
head_id()
set(original_tip "${id}")
run_ok(switch main)
file(WRITE "${repo}/onto" "main only\n")
run_ok(add onto)
run_ok(commit -m main)
head_id()
set(onto "${id}")
run_ok(switch topic)
run_ok(config user.name Receiver)
run_ok(config user.email receiver@example.test)
file(WRITE "${repo}/transient" "unknown occupant\n")
run_error(1 rebase main)
if(NOT EXISTS "${repo}/.minigit/operation" OR EXISTS "${repo}/.minigit/transaction")
    message(FATAL_ERROR "blocked Ready did not preserve durable progress")
endif()
expect_file(.minigit/refs/heads/topic "${original_tip}\n")
head_id()
if(NOT id STREQUAL onto)
    message(FATAL_ERROR "blocked source was incorrectly committed")
endif()
run_error(1 rebase --continue)
expect_file(transient "unknown occupant\n")
file(REMOVE "${repo}/transient")
run_ok(rebase --continue)
head_id()
expect_rewritten("${id}" final-source)
set(rewritten_first "${parent_id}")
expect_rewritten("${rewritten_first}" transient-source)
if(NOT parent_id STREQUAL onto)
    message(FATAL_ERROR "Ready retry skipped the pending source")
endif()
run_ok(show "${rewritten_first}:transient")
if(NOT output STREQUAL "source transient\n" OR EXISTS "${repo}/transient" OR EXISTS "${repo}/.minigit/operation")
    message(FATAL_ERROR "Ready retry did not replay the real transient change")
endif()
expect_file(note "final topic\n")
