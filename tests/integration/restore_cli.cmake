set(repo "${CMAKE_CURRENT_BINARY_DIR}/restore-cli-repository")
file(REMOVE_RECURSE "${repo}")
file(MAKE_DIRECTORY "${repo}")
function(run_ok)
    execute_process(COMMAND "${MINIGIT}" ${ARGV} WORKING_DIRECTORY "${repo}"
        RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_VARIABLE err)
    if(NOT rc EQUAL 0)
        message(FATAL_ERROR "${ARGV}: ${rc} ${err}")
    endif()
    set(output "${out}" PARENT_SCOPE)
endfunction()
function(run_error expected)
    execute_process(COMMAND "${MINIGIT}" ${ARGN} WORKING_DIRECTORY "${repo}"
        RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_VARIABLE err)
    if(NOT rc EQUAL expected OR NOT out STREQUAL "")
        message(FATAL_ERROR "${ARGN}: expected ${expected}, got ${rc}, ${out} ${err}")
    endif()
endfunction()
function(expect_file path expected)
    file(READ "${repo}/${path}" observed)
    if(NOT observed STREQUAL expected)
        message(FATAL_ERROR "${path}: expected '${expected}', got '${observed}'")
    endif()
endfunction()
function(expect_index path expected)
    run_ok(show ":${path}")
    if(NOT output STREQUAL expected)
        message(FATAL_ERROR "index ${path}: expected '${expected}', got '${output}'")
    endif()
endfunction()
run_ok(init)
run_error(2 restore)
run_error(2 restore --source)
run_error(2 restore --source= note)
run_error(2 restore -S --staged note)
run_error(2 restore -W --worktree note)
run_error(2 restore -s HEAD --source HEAD note)
run_error(2 restore --force note)
file(WRITE "${repo}/note" "unborn staged\n")
run_ok(add note)
file(WRITE "${repo}/note" "unborn dirty\n")
run_error(1 restore -S note)
run_ok(restore note)
expect_file(note "unborn staged\n")
run_ok(config user.name Learner)
run_ok(config user.email learner@example.test)
file(WRITE "${repo}/note" "A\n")
file(WRITE "${repo}/-name" "option file\n")
file(MAKE_DIRECTORY "${repo}/dir")
file(WRITE "${repo}/dir/file" "nested A\n")
file(WRITE "${repo}/empty" "")
file(WRITE "${repo}/legacy" "legacy A\n")
run_ok(add -A)
run_ok(commit -m A)
file(READ "${repo}/.minigit/refs/heads/main" first)
string(STRIP "${first}" first)
file(WRITE "${repo}/note" "B\n")
file(WRITE "${repo}/new" "new in B\n")
file(REMOVE "${repo}/legacy")
run_ok(add -A)
run_ok(commit -m B)
foreach(path IN ITEMS HEAD refs/heads/main logs/HEAD logs/refs/heads/main identity)
    file(SHA256 "${repo}/.minigit/${path}" before_${path})
endforeach()
# Default copies Index into Work; staged copies HEAD into Index only.
file(WRITE "${repo}/note" "staged\n")
run_ok(add note)
file(WRITE "${repo}/note" "working\n")
run_ok(restore note)
expect_file(note "staged\n")
file(WRITE "${repo}/note" "working\n")
run_ok(restore --staged note)
expect_index(note "B\n")
expect_file(note "working\n")
run_ok(restore -S -W note)
expect_index(note "B\n")
expect_file(note "B\n")
# Explicit history source does not move HEAD or clear the Index by default.
run_ok(restore --source=${first} note)
expect_file(note "A\n")
expect_index(note "B\n")
run_ok(restore -s "${first}" -S -W note new empty)
expect_index(note "A\n")
if(EXISTS "${repo}/new")
    message(FATAL_ERROR "source-absent selected file was not removed")
endif()
expect_file(empty "")
run_error(1 show :new)
# Every original selector must match: valid earlier paths cannot mask errors.
file(WRITE "${repo}/note" "keep dirty\n")
file(SHA256 "${repo}/.minigit/index" before_index)
run_error(1 restore note nonexistent)
expect_file(note "keep dirty\n")
file(SHA256 "${repo}/.minigit/index" after_index)
if(NOT before_index STREQUAL after_index)
    message(FATAL_ERROR "unmatched selector modified the index")
endif()
file(WRITE "${repo}/-name" "dirty\n")
run_ok(restore -- -name)
expect_file(-name "option file\n")
# Index-only selection does not read physical symlink parents or outside data.
file(WRITE "${repo}/dir/file" "staged nested\n")
run_ok(add dir/file)
set(outside "${CMAKE_CURRENT_BINARY_DIR}/restore-outside")
file(REMOVE_RECURSE "${outside}")
file(MAKE_DIRECTORY "${outside}")
file(WRITE "${outside}/file" "outside\n")
file(REMOVE_RECURSE "${repo}/dir")
file(CREATE_LINK "${outside}" "${repo}/dir" SYMBOLIC RESULT link_result)
if(NOT link_result STREQUAL "0")
    message(FATAL_ERROR "cannot create fixture symlink: ${link_result}")
endif()
run_ok(restore -S dir/file)
expect_index(dir/file "nested A\n")
run_error(1 restore dir/file)
file(READ "${outside}/file" outside_bytes)
if(NOT outside_bytes STREQUAL "outside\n" OR NOT IS_SYMLINK "${repo}/dir")
    message(FATAL_ERROR "restore touched the physical symlink target")
endif()
file(REMOVE "${repo}/dir")
file(MAKE_DIRECTORY "${repo}/dir")
run_ok(restore dir)
expect_file(dir/file "nested A\n")
# A historical-only source path cannot overwrite a current untracked collision.
file(WRITE "${repo}/legacy" "private\n")
file(SHA256 "${repo}/.minigit/index" before_collision)
run_error(1 restore -s "${first}" -S -W legacy)
expect_file(legacy "private\n")
file(SHA256 "${repo}/.minigit/index" after_collision)
if(NOT before_collision STREQUAL after_collision)
    message(FATAL_ERROR "untracked collision partially changed the index")
endif()
foreach(path IN ITEMS HEAD refs/heads/main logs/HEAD logs/refs/heads/main identity)
    file(SHA256 "${repo}/.minigit/${path}" observed)
    if(NOT observed STREQUAL "${before_${path}}")
        message(FATAL_ERROR "restore changed unrelated metadata ${path}")
    endif()
endforeach()
if(EXISTS "${repo}/.minigit/transaction")
    message(FATAL_ERROR "restore left a transaction journal")
endif()
file(REMOVE_RECURSE "${repo}" "${outside}")
