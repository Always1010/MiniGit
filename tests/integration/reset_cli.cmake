set(repo "${CMAKE_CURRENT_BINARY_DIR}/reset-cli-repository")
file(REMOVE_RECURSE "${repo}")
file(MAKE_DIRECTORY "${repo}")
function(run_ok)
    execute_process(COMMAND "${MINIGIT}" ${ARGV} WORKING_DIRECTORY "${repo}"
        RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_VARIABLE err)
    if(NOT rc EQUAL 0 OR (ARGV0 STREQUAL "reset" AND NOT out STREQUAL ""))
        message(FATAL_ERROR "${ARGV}: ${rc} ${out} ${err}")
    endif()
    set(output "${out}" PARENT_SCOPE)
endfunction()
function(run_error expected)
    execute_process(COMMAND "${MINIGIT}" ${ARGN} WORKING_DIRECTORY "${repo}"
        RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_VARIABLE err)
    if(NOT rc EQUAL expected OR NOT out STREQUAL "")
        message(FATAL_ERROR "${ARGN}: expected ${expected}, got ${rc}, ${out} ${err}")
    endif()
endfunction()
function(expect_file path expected)
    file(READ "${repo}/${path}" observed)
    if(NOT observed STREQUAL expected)
        message(FATAL_ERROR "${path}: expected '${expected}', got '${observed}'")
    endif()
endfunction()
function(expect_index path expected)
    run_ok(show ":${path}")
    if(NOT output STREQUAL expected)
        message(FATAL_ERROR "index ${path}: expected '${expected}', got '${output}'")
    endif()
endfunction()
run_ok(init)
run_error(2 reset --soft --hard)
run_error(2 reset --mixed --mixed)
run_error(2 reset --keep)
run_error(2 reset HEAD extra)
run_error(1 reset HEAD)
file(WRITE "${repo}/new" "staged unborn\n")
file(WRITE "${repo}/private" "untracked\n")
run_ok(add new)
file(WRITE "${repo}/new" "dirty unborn\n")
run_ok(reset --soft)
expect_index(new "staged unborn\n")
expect_file(new "dirty unborn\n")
run_ok(reset)
expect_file(new "dirty unborn\n")
run_error(1 show :new)
run_ok(add new)
file(WRITE "${repo}/new" "discard unborn\n")
run_ok(reset --hard)
if(EXISTS "${repo}/new" OR EXISTS "${repo}/.minigit/refs/heads/main" OR EXISTS "${repo}/.minigit/logs/HEAD")
    message(FATAL_ERROR "unborn reset failed or created a ref/log")
endif()
expect_file(private "untracked\n")
run_ok(config user.name Learner)
run_ok(config user.email learner@example.test)
file(WRITE "${repo}/note" "A\n")
file(WRITE "${repo}/legacy" "legacy A\n")
file(MAKE_DIRECTORY "${repo}/shape")
file(WRITE "${repo}/shape/child" "child A\n")
run_ok(add note legacy shape)
run_ok(commit -m A)
file(READ "${repo}/.minigit/refs/heads/main" first)
string(STRIP "${first}" first)
file(WRITE "${repo}/note" "B\n")
file(REMOVE "${repo}/legacy")
file(REMOVE_RECURSE "${repo}/shape")
file(WRITE "${repo}/shape" "parent B\n")
run_ok(add note legacy shape)
run_ok(commit -m B)
file(READ "${repo}/.minigit/refs/heads/main" second)
string(STRIP "${second}" second)
run_ok(branch saved)
# Soft retains B in Index and C in Work while advancing the current branch.
file(WRITE "${repo}/note" "C\n")
run_ok(reset --soft "${first}")
expect_file(.minigit/HEAD "ref: refs/heads/main\n")
expect_file(.minigit/refs/heads/main "${first}\n")
expect_index(note "B\n")
expect_file(note "C\n")
run_ok(reflog)
if(NOT output MATCHES "^HEAD@[{]0[}] ${second} -> ${first} reset:soft\n")
    message(FATAL_ERROR "soft reset did not record one reference movement")
endif()
run_ok(reset)
expect_index(note "A\n")
expect_file(note "C\n")
run_ok(reset --hard saved)
expect_index(note "B\n")
expect_file(note "B\n")
expect_file(.minigit/HEAD "ref: refs/heads/main\n")
# A same-commit hard reset still discards B/C changes without a reflog event.
file(WRITE "${repo}/note" "staged\n")
run_ok(add note)
file(WRITE "${repo}/note" "dirty\n")
file(SHA256 "${repo}/.minigit/logs/HEAD" same_head_log)
file(SHA256 "${repo}/.minigit/logs/refs/heads/main" same_branch_log)
run_ok(reset --hard)
expect_file(note "B\n")
expect_index(note "B\n")
file(SHA256 "${repo}/.minigit/logs/HEAD" after_head_log)
file(SHA256 "${repo}/.minigit/logs/refs/heads/main" after_branch_log)
if(NOT same_head_log STREQUAL after_head_log OR NOT same_branch_log STREQUAL after_branch_log)
    message(FATAL_ERROR "same-commit reset added a reference event")
endif()
# A target-only historical path cannot replace an untracked collision.
file(WRITE "${repo}/legacy" "private legacy\n")
file(SHA256 "${repo}/.minigit/index" blocked_index)
file(SHA256 "${repo}/.minigit/logs/HEAD" blocked_log)
run_error(1 reset --hard "${first}")
expect_file(note "B\n")
expect_file(legacy "private legacy\n")
expect_file(.minigit/refs/heads/main "${second}\n")
file(SHA256 "${repo}/.minigit/index" observed_index)
file(SHA256 "${repo}/.minigit/logs/HEAD" observed_log)
if(NOT blocked_index STREQUAL observed_index OR NOT blocked_log STREQUAL observed_log)
    message(FATAL_ERROR "refused hard reset partially published metadata")
endif()
file(REMOVE "${repo}/legacy")
run_ok(reset --hard "${first}")
expect_file(shape/child "child A\n")
file(WRITE "${repo}/shape/private" "private child\n")
run_error(1 reset --hard saved)
expect_file(shape/private "private child\n")
expect_file(shape/child "child A\n")
expect_file(.minigit/refs/heads/main "${first}\n")
file(REMOVE "${repo}/shape/private")
run_ok(reset --hard saved)
expect_file(shape "parent B\n")
# Detached reset changes HEAD without moving a branch.
run_ok(switch --detach)
run_ok(reset --hard "${first}")
expect_file(.minigit/HEAD "${first}\n")
expect_file(.minigit/refs/heads/main "${second}\n")
expect_file(note "A\n")
run_ok(branch -- -revision "${second}")
run_ok(reset --soft -- -revision)
expect_file(.minigit/HEAD "${second}\n")
expect_index(note "A\n")
expect_file(note "A\n")
expect_file(private "untracked\n")
if(EXISTS "${repo}/.minigit/transaction")
    message(FATAL_ERROR "reset left a journal")
endif()
file(REMOVE_RECURSE "${repo}")
