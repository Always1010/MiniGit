set(repo "${CMAKE_CURRENT_BINARY_DIR}/commits-cli-repository")
file(REMOVE_RECURSE "${repo}")
file(MAKE_DIRECTORY "${repo}")
function(run_ok)
    execute_process(COMMAND "${MINIGIT}" ${ARGV} WORKING_DIRECTORY "${repo}"
        RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_VARIABLE err)
    if(NOT rc EQUAL 0)
        message(FATAL_ERROR "${ARGV}: ${rc} ${err}")
    endif()
    set(output "${out}" PARENT_SCOPE)
endfunction()
function(run_fail expected)
    execute_process(COMMAND "${MINIGIT}" ${ARGN} WORKING_DIRECTORY "${repo}"
        RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_VARIABLE err)
    if(NOT rc EQUAL expected OR err STREQUAL "")
        message(FATAL_ERROR "${ARGN}: expected ${expected}, got ${rc} ${out} ${err}")
    endif()
endfunction()
run_ok(init)
file(WRITE "${repo}/note" "staged\n")
file(MAKE_DIRECTORY "${repo}/nested")
file(WRITE "${repo}/nested/empty" "")
run_ok(add -A)
run_fail(1 commit -m "identity required")
if(EXISTS "${repo}/.minigit/refs/heads/main")
    message(FATAL_ERROR "failed identity validation moved HEAD")
endif()
run_ok(config user.name Learner)
run_ok(config user.email learner@example.test)
run_ok(config user.name)
if(NOT output STREQUAL "Learner\n")
    message(FATAL_ERROR "config did not round trip")
endif()
file(SHA256 "${repo}/.minigit/identity" identity_before)
run_fail(1 config user.name "bad\nname")
file(SHA256 "${repo}/.minigit/identity" identity_after)
if(NOT identity_after STREQUAL identity_before)
    message(FATAL_ERROR "invalid identity replaced config")
endif()
run_ok(hash-object note)
string(STRIP "${output}" staged_blob)
file(WRITE "${repo}/note" "working\n")
run_ok(commit -m "first snapshot")
file(READ "${repo}/.minigit/refs/heads/main" first)
string(STRIP "${first}" first)
run_ok(cat-file -p "${first}")
if(output MATCHES "\nparent " OR NOT output MATCHES "\n\nfirst snapshot$")
    message(FATAL_ERROR "first commit parents or message invalid: ${output}")
endif()
if(NOT output MATCHES "author Learner <learner@example.test> [0-9]+ \\+0000\n")
    message(FATAL_ERROR "commit identity is not normalized: ${output}")
endif()
string(REGEX MATCH "^tree ([0-9a-f]+)\n" tree_line "${output}")
set(first_tree "${CMAKE_MATCH_1}")
run_ok(cat-file -p "${first_tree}")
if(NOT output MATCHES "100644 ${staged_blob} note\n" OR NOT output MATCHES "40000 [0-9a-f]+ nested\n")
    message(FATAL_ERROR "commit did not use the staged nested snapshot: ${output}")
endif()
run_ok(cat-file -p "${staged_blob}")
if(NOT output STREQUAL "staged\n")
    message(FATAL_ERROR "staged blob changed")
endif()
run_fail(1 commit -m "unchanged")
file(READ "${repo}/.minigit/refs/heads/main" after_failure)
string(STRIP "${after_failure}" after_failure)
if(NOT after_failure STREQUAL first)
    message(FATAL_ERROR "unchanged commit moved HEAD")
endif()
run_ok(add note)
run_ok(commit -m "second snapshot\n\nexplanation")
file(READ "${repo}/.minigit/refs/heads/main" second)
string(STRIP "${second}" second)
run_ok(cat-file -p "${second}")
if(NOT output MATCHES "\nparent ${first}\n" OR NOT output MATCHES "second snapshot\n\nexplanation$")
    message(FATAL_ERROR "second commit parent or multiline message invalid")
endif()
file(REMOVE "${repo}/note")
run_ok(add note)
run_ok(commit -m "delete note")
run_fail(2 commit)
run_fail(2 config unknown value)
file(REMOVE_RECURSE "${repo}")
