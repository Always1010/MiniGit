execute_process(COMMAND "${MINIGIT}" --help RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_VARIABLE err)
if(NOT rc EQUAL 0 OR NOT out MATCHES "Usage: minigit" OR NOT err STREQUAL "")
    message(FATAL_ERROR "help failed: ${rc} ${out} ${err}")
endif()
execute_process(COMMAND "${MINIGIT}" --version RESULT_VARIABLE rc OUTPUT_VARIABLE out)
if(NOT rc EQUAL 0 OR NOT out MATCHES "minigit [0-9]+\\.[0-9]+\\.[0-9]+")
    message(FATAL_ERROR "version failed")
endif()
foreach(args IN ITEMS "" "unknown" "--version;extra")
    execute_process(COMMAND "${MINIGIT}" ${args} RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_VARIABLE err)
    if(NOT rc EQUAL 2 OR NOT out STREQUAL "" OR NOT err MATCHES "invalid arguments")
        message(FATAL_ERROR "bad arguments accepted: ${args}")
    endif()
endforeach()
