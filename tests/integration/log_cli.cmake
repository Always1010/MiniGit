set(repo "${CMAKE_CURRENT_BINARY_DIR}/log-cli-repository")
file(REMOVE_RECURSE "${repo}")
file(MAKE_DIRECTORY "${repo}")
function(run_ok)
    execute_process(COMMAND "${MINIGIT}" ${ARGV} WORKING_DIRECTORY "${repo}"
        RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_VARIABLE err)
    if(NOT rc EQUAL 0)
        message(FATAL_ERROR "${ARGV}: ${rc} ${err}")
    endif()
    set(output "${out}" PARENT_SCOPE)
endfunction()
run_ok(init)
run_ok(log)
if(NOT output STREQUAL "No commits yet\n")
    message(FATAL_ERROR "unborn log did not explain empty history")
endif()
run_ok(log --oneline)
if(NOT output STREQUAL "")
    message(FATAL_ERROR "unborn oneline log should be empty")
endif()
run_ok(config user.name Learner)
run_ok(config user.email learner@example.test)
file(WRITE "${repo}/note" "first\n")
run_ok(add note)
run_ok(commit -m "first\n\nexplanation")
file(READ "${repo}/.minigit/refs/heads/main" first)
string(STRIP "${first}" first)
string(SUBSTRING "${first}" 0 12 first_short)
file(WRITE "${repo}/note" "second\n")
run_ok(add note)
run_ok(commit -m second)
file(READ "${repo}/.minigit/refs/heads/main" second)
string(STRIP "${second}" second)
string(SUBSTRING "${second}" 0 12 second_short)
run_ok(log --oneline)
if(NOT output STREQUAL "${second_short} second\n${first_short} first\n")
    message(FATAL_ERROR "log history order or multiline summary invalid: ${output}")
endif()
run_ok(log --oneline -n 1 main)
if(NOT output STREQUAL "${second_short} second\n")
    message(FATAL_ERROR "log limit or branch resolution failed")
endif()
run_ok(log --oneline "${first}")
if(NOT output STREQUAL "${first_short} first\n")
    message(FATAL_ERROR "log from explicit commit failed")
endif()
run_ok(log -n 0)
if(NOT output STREQUAL "")
    message(FATAL_ERROR "log -n 0 did not produce empty output")
endif()
run_ok(log -n 1)
if(NOT output MATCHES "^commit ${second}\nparent ${first}\nauthor Learner <learner@example.test>" OR NOT output MATCHES "\n    second\n")
    message(FATAL_ERROR "full log omits identity parent or message")
endif()
foreach(args IN ITEMS "-n;-1" "-n;invalid" "-n;99999999999999999999999999999999999999999" "--unknown" "main;extra")
    execute_process(COMMAND "${MINIGIT}" log ${args} WORKING_DIRECTORY "${repo}"
        RESULT_VARIABLE rc ERROR_VARIABLE err)
    if(NOT rc EQUAL 2)
        message(FATAL_ERROR "log accepted invalid args: ${args}")
    endif()
endforeach()
execute_process(COMMAND "${MINIGIT}" log missing WORKING_DIRECTORY "${repo}"
    RESULT_VARIABLE rc ERROR_VARIABLE err)
if(NOT rc EQUAL 1)
    message(FATAL_ERROR "log accepted missing revision")
endif()
file(REMOVE_RECURSE "${repo}")
