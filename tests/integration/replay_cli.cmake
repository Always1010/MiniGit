set(repo "${CMAKE_CURRENT_BINARY_DIR}/replay-cli-repository")
file(REMOVE_RECURSE "${repo}")
file(MAKE_DIRECTORY "${repo}")
function(run_ok)
    execute_process(COMMAND "${MINIGIT}" ${ARGV} WORKING_DIRECTORY "${repo}"
        RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_VARIABLE err)
    if(NOT rc EQUAL 0)
        message(FATAL_ERROR "${ARGV}: ${rc} ${out} ${err}")
    endif()
    set(output "${out}" PARENT_SCOPE)
endfunction()
function(run_error expected)
    execute_process(COMMAND "${MINIGIT}" ${ARGN} WORKING_DIRECTORY "${repo}"
        RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_VARIABLE err)
    if(NOT rc EQUAL expected OR NOT out STREQUAL "")
        message(FATAL_ERROR "${ARGN}: expected ${expected}, got ${rc}: ${out} ${err}")
    endif()
endfunction()
function(run_conflict)
    execute_process(COMMAND "${MINIGIT}" ${ARGV} WORKING_DIRECTORY "${repo}"
        RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_VARIABLE err)
    if(NOT rc EQUAL 1 OR NOT out MATCHES "paused" OR NOT out MATCHES "CONFLICT note" OR NOT err STREQUAL "")
        message(FATAL_ERROR "${ARGV}: expected a published conflict: ${rc} ${out} ${err}")
    endif()
    if(NOT EXISTS "${repo}/.minigit/operation" OR EXISTS "${repo}/.minigit/transaction")
        message(FATAL_ERROR "conflict state was not published completely")
    endif()
endfunction()
function(head_id)
    run_ok(log -n 1)
    string(REGEX MATCH "^commit ([0-9a-f]+)\n" header "${output}")
    set(id "${CMAKE_MATCH_1}")
    string(LENGTH "${id}" length)
    if(NOT length EQUAL 64)
        message(FATAL_ERROR "expected a complete commit ID: ${output}")
    endif()
    set(id "${id}" PARENT_SCOPE)
endfunction()
function(expect_commit parent author message)
    head_id()
    run_ok(cat-file -p "${id}")
    string(FIND "${output}" "parent ${parent}\nauthor ${author}" parent_position)
    string(FIND "${output}" "\n\n${message}" message_position)
    if(parent_position LESS 0 OR message_position LESS 0)
        message(FATAL_ERROR "wrong single parent, author or message: ${output}")
    endif()
endfunction()
function(expect_file path expected)
    file(READ "${repo}/${path}" actual)
    if(NOT actual STREQUAL expected)
        message(FATAL_ERROR "${path}: expected '${expected}', got '${actual}'")
    endif()
endfunction()
run_ok(init)
foreach(command IN ITEMS cherry-pick revert)
    run_error(2 "${command}")
    run_error(2 "${command}" --continue --abort)
    run_error(2 "${command}" --continue HEAD)
    run_error(2 "${command}" --abort --message unwanted)
    run_error(2 "${command}" --message)
    run_error(2 "${command}" HEAD HEAD)
    run_error(2 "${command}" -m 1 HEAD)
    run_error(2 "${command}" --mainline 1 HEAD)
    run_error(1 "${command}" --continue)
    run_error(1 "${command}" --abort)
endforeach()
run_ok(config user.name Source)
run_ok(config user.email source@example.test)
file(WRITE "${repo}/note" "base\n")
file(WRITE "${repo}/extra" "base extra\n")
run_ok(add -A)
run_ok(commit -m base)
run_ok(switch -c source)
file(WRITE "${repo}/note" "source\n")
run_ok(add note)
run_ok(commit -m source-message)
head_id()
set(source "${id}")
run_ok(switch main)
run_ok(config user.name Receiver)
run_ok(config user.email receiver@example.test)
file(WRITE "${repo}/extra" "receiver extra\n")
run_ok(add extra)
run_ok(commit -m receiver)
head_id()
set(receiver "${id}")
run_ok(cherry-pick source)
expect_file(note "source\n")
expect_file(extra "receiver extra\n")
expect_commit("${receiver}" "Source <source@example.test>" "source-message")
head_id()
set(picked "${id}")
run_ok(cherry-pick --message preserved-empty source)
expect_commit("${picked}" "Source <source@example.test>" "preserved-empty")
head_id()
set(empty_pick "${id}")
if(empty_pick STREQUAL picked)
    message(FATAL_ERROR "empty cherry-pick did not create a commit")
endif()
run_ok(revert source)
expect_file(note "base\n")
expect_file(extra "receiver extra\n")
expect_commit("${empty_pick}" "Receiver <receiver@example.test>" "Revert ${source}")
head_id()
set(reverted "${id}")
run_ok(revert --message inverse-empty "${source}")
expect_commit("${reverted}" "Receiver <receiver@example.test>" "inverse-empty")
# Matching command controls a paused operation. Continue takes B, preserving C.
file(WRITE "${repo}/note" "ours conflict\n")
run_ok(add note)
run_ok(commit -m ours)
head_id()
set(ours "${id}")
run_conflict(cherry-pick --message manual-pick source)
run_error(1 merge --continue)
run_error(1 merge --abort)
run_error(1 revert --continue)
run_error(1 revert --abort)
run_error(1 commit -m blocked)
run_error(1 cherry-pick --continue)
run_ok(config user.name Resolver)
run_ok(config user.email resolver@example.test)
file(WRITE "${repo}/note" "staged resolution\n")
run_ok(add note)
file(WRITE "${repo}/note" "unstaged resolution\n")
run_ok(cherry-pick --continue)
expect_commit("${ours}" "Source <source@example.test>" "manual-pick")
expect_file(note "unstaged resolution\n")
run_ok(show HEAD:note)
if(NOT output STREQUAL "staged resolution\n")
    message(FATAL_ERROR "cherry-pick continuation captured unstaged content")
endif()
head_id()
set(resolution "${id}")
run_ok(restore note)
run_conflict(revert --message manual-inverse source)
run_error(1 cherry-pick --continue)
run_error(1 cherry-pick --abort)
file(WRITE "${repo}/note" "inverse resolution\n")
run_ok(add note)
run_ok(revert --continue)
expect_commit("${resolution}" "Resolver <resolver@example.test>" "manual-inverse")
# Both commands restore exact Index and affected work on abort.
foreach(command IN ITEMS cherry-pick revert)
    file(CHMOD "${repo}/note" PERMISSIONS OWNER_READ OWNER_WRITE GROUP_READ)
    file(SHA256 "${repo}/.minigit/index" original_index)
    file(READ "${repo}/.minigit/HEAD" original_head)
    run_conflict("${command}" source)
    file(WRITE "${repo}/note" "edited marker\n")
    run_ok("${command}" --abort)
    expect_file(note "inverse resolution\n")
    expect_file(.minigit/HEAD "${original_head}")
    file(SHA256 "${repo}/.minigit/index" restored_index)
    execute_process(COMMAND stat -c %a "${repo}/note" RESULT_VARIABLE rc OUTPUT_VARIABLE mode OUTPUT_STRIP_TRAILING_WHITESPACE)
    if(NOT original_index STREQUAL restored_index OR NOT rc EQUAL 0 OR NOT mode STREQUAL "640" OR EXISTS "${repo}/.minigit/operation")
        message(FATAL_ERROR "${command} abort lost exact Index, mode or state cleanup")
    endif()
endforeach()
# Generate a real multi-parent source using MiniGit; mainline is unsupported.
run_conflict(merge source)
file(WRITE "${repo}/note" "merge resolution\n")
run_ok(add note)
run_ok(merge --continue)
head_id()
set(multi_parent "${id}")
file(SHA256 "${repo}/.minigit/index" before_index)
run_error(1 cherry-pick "${multi_parent}")
run_error(1 revert "${multi_parent}")
head_id()
file(SHA256 "${repo}/.minigit/index" after_index)
if(NOT id STREQUAL multi_parent OR NOT before_index STREQUAL after_index OR EXISTS "${repo}/.minigit/operation")
    message(FATAL_ERROR "rejected multi-parent source mutated history or Index")
endif()
expect_file(note "merge resolution\n")
