set(repo "${CMAKE_CURRENT_BINARY_DIR}/stash-restore-cli-repository")
function(run expected)
    execute_process(COMMAND "${MINIGIT}" ${ARGN} WORKING_DIRECTORY "${repo}"
        RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_VARIABLE err)
    if(NOT rc EQUAL expected)
        message(FATAL_ERROR "${ARGN}: expected ${expected}, got ${rc}: ${out} ${err}")
    endif()
    set(output "${out}" PARENT_SCOPE)
endfunction()
function(expect_file path expected)
    file(READ "${repo}/${path}" actual)
    if(NOT actual STREQUAL expected)
        message(FATAL_ERROR "${path}: expected '${expected}', got '${actual}'")
    endif()
endfunction()
function(fixture content)
    file(REMOVE_RECURSE "${repo}")
    file(MAKE_DIRECTORY "${repo}")
    run(0 init)
    run(0 config user.name Learner)
    run(0 config user.email learner@example.test)
    file(WRITE "${repo}/f" "${content}")
    run(0 add f)
    run(0 commit -m base)
endfunction()
function(history_before)
    file(SHA256 "${repo}/.minigit/HEAD" h)
    file(SHA256 "${repo}/.minigit/refs/heads/main" b)
    file(SHA256 "${repo}/.minigit/logs/HEAD" l)
    file(SHA256 "${repo}/.minigit/logs/refs/heads/main" bl)
    set(history "${h};${b};${l};${bl}" PARENT_SCOPE)
endfunction()
function(expect_history)
    history_before()
    if(NOT history STREQUAL ARGV0)
        message(FATAL_ERROR "stash restore moved HEAD, branch or logs")
    endif()
endfunction()

# Independent saved Index and Work merge onto a newer current HEAD.
fixture("one\ntwo\nthree\n")
file(WRITE "${repo}/f" "ONE\ntwo\nthree\n")
run(0 add f)
file(WRITE "${repo}/f" "ONE\nTWO\nthree\n")
run(0 stash push -m layers)
file(WRITE "${repo}/f" "one\ntwo\nTHREE\n")
run(0 add f)
run(0 commit -m current)
history_before()
set(saved_history "${history}")
file(SHA256 "${repo}/.minigit/stashstack" stack)
file(SHA256 "${repo}/.minigit/index" original_index)
file(REMOVE "${repo}/.minigit/identity")
run(0 stash apply)
expect_file(f "ONE\nTWO\nTHREE\n")
run(0 show :f)
if(NOT output STREQUAL "one\ntwo\nTHREE\n")
    message(FATAL_ERROR "default apply should retain current staged content: ${output}")
endif()
file(SHA256 "${repo}/.minigit/index" actual_index)
if(NOT actual_index STREQUAL original_index)
    message(FATAL_ERROR "default apply unnecessarily rewrote raw Index")
endif()
expect_history("${saved_history}")
run(1 stash apply)
run(0 reset --hard)
run(0 stash apply --index -- "stash@{0}")
expect_file(f "ONE\nTWO\nTHREE\n")
run(0 show :f)
if(NOT output STREQUAL "ONE\ntwo\nTHREE\n")
    message(FATAL_ERROR "--index lost independent saved staging intent: ${output}")
endif()
expect_history("${saved_history}")
run(0 reset --hard)
run(0 stash pop "stash@{0}" --index)
expect_file(f "ONE\nTWO\nTHREE\n")
if(EXISTS "${repo}/.minigit/stashstack" OR EXISTS "${repo}/.minigit/refs/stash")
    message(FATAL_ERROR "successful pop retained the selected entry")
endif()
expect_history("${saved_history}")
run(2 stash apply --index --index)
run(2 stash pop --unknown)
run(2 stash apply 0)
run(2 stash apply "stash@{0}" "stash@{1}")
run(2 stash apply -- --index)
run(2 stash --continue --index)
run(2 stash --abort extra)
run(1 stash --continue)
run(1 stash --abort)

# Work conflict: pop keeps its entry until continuation, which never reads Work.
fixture("A\n")
file(WRITE "${repo}/f" "C\n")
run(0 stash push)
file(WRITE "${repo}/f" "D\n")
run(0 add f)
run(0 commit -m current)
history_before()
set(saved_history "${history}")
file(SHA256 "${repo}/.minigit/stashstack" saved_stack)
file(REMOVE "${repo}/.minigit/identity")
run(1 stash pop)
if(NOT output MATCHES "CONFLICT \\(work\\) f" OR NOT output MATCHES "stash --continue")
    message(FATAL_ERROR "missing work conflict guidance: ${output}")
endif()
file(SHA256 "${repo}/.minigit/stashstack" actual_stack)
if(NOT actual_stack STREQUAL saved_stack OR NOT EXISTS "${repo}/.minigit/operation")
    message(FATAL_ERROR "conflicted pop dropped entry or omitted State")
endif()
run(1 stash --continue)
run(1 stash drop)
run(1 stash apply)
run(1 commit -m blocked)
file(WRITE "${repo}/f" "resolved\n")
run(0 add f)
file(REMOVE "${repo}/f")
execute_process(COMMAND mkfifo "${repo}/f" RESULT_VARIABLE rc)
if(NOT rc EQUAL 0)
    message(FATAL_ERROR "could not create the no-Work-read continuation fixture")
endif()
run(0 stash --continue)
execute_process(COMMAND test -p "${repo}/f" RESULT_VARIABLE rc)
if(NOT rc EQUAL 0 OR EXISTS "${repo}/.minigit/operation" OR EXISTS "${repo}/.minigit/stashstack")
    message(FATAL_ERROR "continue did not preserve FIFO Work, delete State and drop entry")
endif()
run(0 show :f)
if(NOT output STREQUAL "resolved\n")
    message(FATAL_ERROR "continue lost resolved Index")
endif()
expect_history("${saved_history}")

# Index-only conflict: Work remains clean, and abort restores exact raw Index.
fixture("A\n")
file(WRITE "${repo}/f" "B\n")
run(0 add f)
file(WRITE "${repo}/f" "A\n")
run(0 stash push)
file(WRITE "${repo}/f" "C\n")
run(0 add f)
run(0 commit -m current)
file(CHMOD "${repo}/f" PERMISSIONS OWNER_READ OWNER_WRITE GROUP_READ)
history_before()
set(saved_history "${history}")
file(SHA256 "${repo}/.minigit/index" original_index)
file(SHA256 "${repo}/.minigit/stashstack" saved_stack)
run(1 stash apply --index)
if(NOT output MATCHES "CONFLICT \\(index\\) f")
    message(FATAL_ERROR "missing index-only conflict report: ${output}")
endif()
expect_file(f "C\n")
file(WRITE "${repo}/f" "resolved\n")
run(0 add f)
run(0 stash --abort)
expect_file(f "C\n")
file(SHA256 "${repo}/.minigit/index" actual_index)
file(SHA256 "${repo}/.minigit/stashstack" actual_stack)
if(NOT actual_index STREQUAL original_index OR NOT actual_stack STREQUAL saved_stack
        OR EXISTS "${repo}/.minigit/operation")
    message(FATAL_ERROR "abort lost original raw Index/stack or retained State")
endif()
expect_history("${saved_history}")

# Saved untracked files may not overwrite occupied paths, even identical bytes.
fixture("A\n")
file(WRITE "${repo}/unknown" "saved\n")
run(0 stash push -u)
file(WRITE "${repo}/unknown" "saved\n")
file(SHA256 "${repo}/.minigit/index" original_index)
file(SHA256 "${repo}/.minigit/stashstack" saved_stack)
run(1 stash pop)
expect_file(unknown "saved\n")
file(SHA256 "${repo}/.minigit/index" actual_index)
file(SHA256 "${repo}/.minigit/stashstack" actual_stack)
if(NOT actual_index STREQUAL original_index OR NOT actual_stack STREQUAL saved_stack
        OR EXISTS "${repo}/.minigit/operation")
    message(FATAL_ERROR "blocked untracked restore published changes")
endif()
file(REMOVE "${repo}/unknown")
run(0 stash pop)
expect_file(unknown "saved\n")
if(EXISTS "${repo}/.minigit/stashstack")
    message(FATAL_ERROR "untracked pop did not drop the completed entry")
endif()
