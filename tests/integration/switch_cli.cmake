set(repo "${CMAKE_CURRENT_BINARY_DIR}/switch-cli-repository")
file(REMOVE_RECURSE "${repo}")
file(MAKE_DIRECTORY "${repo}")
function(run_ok)
    execute_process(COMMAND "${MINIGIT}" ${ARGV} WORKING_DIRECTORY "${repo}"
        RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_VARIABLE err)
    if(NOT rc EQUAL 0)
        message(FATAL_ERROR "${ARGV}: ${rc} ${err}")
    endif()
    set(output "${out}" PARENT_SCOPE)
endfunction()
function(run_error expected)
    execute_process(COMMAND "${MINIGIT}" ${ARGN} WORKING_DIRECTORY "${repo}"
        RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_VARIABLE err)
    if(NOT rc EQUAL expected OR NOT out STREQUAL "")
        message(FATAL_ERROR "${ARGN}: expected ${expected}, got ${rc}, ${out} ${err}")
    endif()
endfunction()
function(expect_file path expected)
    file(READ "${repo}/${path}" observed)
    if(NOT observed STREQUAL expected)
        message(FATAL_ERROR "${path}: expected '${expected}', got '${observed}'")
    endif()
endfunction()
run_ok(init)
run_error(2 switch)
run_error(2 switch --force main)
run_error(2 switch -c)
run_error(2 switch --detach -c topic)
run_error(2 switch main extra)
run_error(2 switch --detach --detach)
run_error(1 switch absent)
run_error(1 switch --detach)
run_ok(switch -c unborn)
expect_file(.minigit/HEAD "ref: refs/heads/unborn\n")
if(EXISTS "${repo}/.minigit/refs/heads/unborn" OR EXISTS "${repo}/.minigit/index")
    message(FATAL_ERROR "unborn switch created a ref or an empty index")
endif()
run_ok(switch unborn)
run_ok(config user.name Learner)
run_ok(config user.email learner@example.test)
file(WRITE "${repo}/note" "A\n")
run_ok(add note)
run_ok(commit -m A)
file(READ "${repo}/.minigit/refs/heads/unborn" first)
string(STRIP "${first}" first)
run_ok(switch -c topic)
file(WRITE "${repo}/note" "B\n")
run_ok(add note)
run_ok(commit -m B)
file(READ "${repo}/.minigit/refs/heads/topic" second)
string(STRIP "${second}" second)
run_ok(switch unborn)
expect_file(note "A\n")
run_ok(show :note)
if(NOT output STREQUAL "A\n")
    message(FATAL_ERROR "index did not follow clean switch")
endif()
run_ok(status -s)
if(NOT output STREQUAL "")
    message(FATAL_ERROR "clean switch is dirty: ${output}")
endif()
# Different staged and working contents survive a same-snapshot branch change.
file(WRITE "${repo}/note" "staged\n")
run_ok(add note)
file(WRITE "${repo}/note" "working\n")
file(SHA256 "${repo}/.minigit/index" dirty_index)
file(SHA256 "${repo}/.minigit/logs/HEAD" head_log)
run_error(1 switch topic)
run_error(1 switch -c blocked topic)
expect_file(.minigit/HEAD "ref: refs/heads/unborn\n")
expect_file(note "working\n")
file(SHA256 "${repo}/.minigit/index" observed_index)
file(SHA256 "${repo}/.minigit/logs/HEAD" observed_log)
if(NOT observed_index STREQUAL dirty_index OR NOT observed_log STREQUAL head_log OR EXISTS "${repo}/.minigit/refs/heads/blocked" OR EXISTS "${repo}/.minigit/logs/refs/heads/blocked")
    message(FATAL_ERROR "refused switch partially published")
endif()
run_ok(switch -c carried)
expect_file(note "working\n")
run_ok(show :note)
if(NOT output STREQUAL "staged\n")
    message(FATAL_ERROR "same-snapshot switch lost staged content")
endif()
# If the staged value already equals the target, preserve working edits.
file(WRITE "${repo}/note" "B\n")
run_ok(add note)
file(WRITE "${repo}/note" "local\n")
run_ok(switch topic)
expect_file(note "local\n")
run_ok(status -s)
if(NOT output STREQUAL " M note\n")
    message(FATAL_ERROR "target-equal index was not preserved: ${output}")
endif()
file(WRITE "${repo}/note" "B\n")
run_ok(switch --detach "${first}")
expect_file(.minigit/HEAD "${first}\n")
expect_file(note "A\n")
run_ok(reflog)
if(NOT output MATCHES "^HEAD@[{]0[}] ${second} -> ${first} switch:detach\n")
    message(FATAL_ERROR "detach event is missing: ${output}")
endif()
run_ok(switch topic)
expect_file(note "B\n")
# Ordinary switch resolves a branch even when a tag has the same name.
run_ok(tag topic "${first}")
run_ok(switch topic)
run_error(1 switch --detach topic)
run_ok(branch -- -label)
run_ok(switch -- -label)
expect_file(.minigit/HEAD "ref: refs/heads/-label\n")
# Unknown target collisions protect both worktree and metadata.
file(WRITE "${repo}/new" "tracked\n")
run_ok(add new)
run_ok(commit -m new)
run_ok(switch unborn)
file(WRITE "${repo}/new" "private\n")
file(SHA256 "${repo}/.minigit/index" before_index)
file(SHA256 "${repo}/.minigit/logs/HEAD" before_log)
run_error(1 switch -- -label)
expect_file(new "private\n")
expect_file(.minigit/HEAD "ref: refs/heads/unborn\n")
file(SHA256 "${repo}/.minigit/index" after_index)
file(SHA256 "${repo}/.minigit/logs/HEAD" after_log)
if(NOT before_index STREQUAL after_index OR NOT before_log STREQUAL after_log OR EXISTS "${repo}/.minigit/transaction")
    message(FATAL_ERROR "unknown collision changed metadata")
endif()
file(REMOVE_RECURSE "${repo}")
