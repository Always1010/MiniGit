set(repo "${CMAKE_CURRENT_BINARY_DIR}/tags-cli-repository")
file(REMOVE_RECURSE "${repo}")
file(MAKE_DIRECTORY "${repo}")
function(run_ok)
    execute_process(COMMAND "${MINIGIT}" ${ARGV} WORKING_DIRECTORY "${repo}"
        RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_VARIABLE err)
    if(NOT rc EQUAL 0)
        message(FATAL_ERROR "${ARGV}: ${rc} ${err}")
    endif()
    set(output "${out}" PARENT_SCOPE)
endfunction()
function(run_fail expected)
    execute_process(COMMAND "${MINIGIT}" ${ARGN} WORKING_DIRECTORY "${repo}"
        RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_VARIABLE err)
    if(NOT rc EQUAL expected OR err STREQUAL "")
        message(FATAL_ERROR "${ARGN}: expected ${expected}, got ${rc} ${out} ${err}")
    endif()
endfunction()
run_ok(init)
run_ok(tag)
if(NOT output STREQUAL "")
    message(FATAL_ERROR "empty tag list should be empty")
endif()
run_fail(1 tag initial)
run_ok(config user.name Learner)
run_ok(config user.email learner@example.test)
file(WRITE "${repo}/note" "first\n")
run_ok(add note)
run_ok(commit -m first)
file(READ "${repo}/.minigit/refs/heads/main" first)
string(STRIP "${first}" first)
string(SUBSTRING "${first}" 0 12 first_short)
run_ok(tag v1)
run_ok(tag topic/sub "${first}")
run_fail(1 tag v1)
run_ok(tag)
if(NOT output STREQUAL "topic/sub\nv1\n")
    message(FATAL_ERROR "tag list not sorted: ${output}")
endif()
file(WRITE "${repo}/note" "second\n")
run_ok(add note)
run_ok(commit -m second)
file(READ "${repo}/.minigit/refs/heads/main" second)
string(STRIP "${second}" second)
run_ok(log --oneline v1)
if(NOT output STREQUAL "${first_short} first\n")
    message(FATAL_ERROR "light tag moved with the branch")
endif()
run_ok(tag -f v1)
file(READ "${repo}/.minigit/refs/tags/v1" moved)
string(STRIP "${moved}" moved)
if(NOT moved STREQUAL second)
    message(FATAL_ERROR "forced tag did not point to HEAD")
endif()
run_ok(tag -d topic/sub)
run_ok(tag topic "${first}")
run_ok(tag -d topic)
run_fail(1 tag -d topic)
run_fail(1 tag ../escape)
run_fail(1 tag HEAD)
run_fail(1 tag "${first}")
run_fail(1 tag broken missing)
run_fail(2 tag -f)
run_fail(2 tag -d)
run_fail(2 tag -f -d v1)
run_ok(tag)
if(NOT output STREQUAL "v1\n")
    message(FATAL_ERROR "failed tag operations changed refs")
endif()
file(READ "${repo}/.minigit/refs/heads/main" head_after)
string(STRIP "${head_after}" head_after)
if(NOT head_after STREQUAL second)
    message(FATAL_ERROR "tag operation moved the branch")
endif()
file(REMOVE_RECURSE "${repo}")
